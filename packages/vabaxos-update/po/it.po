msgid "Updates"
msgstr "Aggiornamenti"

msgid "Updating: {percent} percent."
msgstr "Aggiornamento: {percent} per cento."

msgid "Looking for updates. Please wait."
msgstr "Cerco gli aggiornamenti. Attendi."

msgid "Cannot look for updates: {error}. Check the network and try again."
msgstr "Non riesco a cercare gli aggiornamenti: {error}. Controlla la rete e riprova."

msgid "{count} security updates are ready. Open Update VabaxOS to install them."
msgstr "Ci sono {count} aggiornamenti di sicurezza. Apri Aggiorna VabaxOS per installarli."

msgid "VabaxOS is up to date."
msgstr "VabaxOS è aggiornato."

msgid "{count} updates, {security} for security; {apps} applications."
msgstr "{count} aggiornamenti, di cui {security} di sicurezza; {apps} applicazioni."

msgid "Note: in this test version updates come straight from Debian testing, not yet checked by VabaxOS."
msgstr "Nota: in questa versione di prova gli aggiornamenti arrivano direttamente da Debian testing, non ancora controllati da VabaxOS."

msgid "To install: vabaxos-update --now, or --at-restart."
msgstr "Per installarli: vabaxos-update --now, oppure --at-restart."

msgid "The update stopped: {error}."
msgstr "L'aggiornamento si è fermato: {error}."

msgid "Ready. The updates will be installed at the next start."
msgstr "Pronto. Gli aggiornamenti verranno installati al prossimo avvio."

msgid "Update finished."
msgstr "Aggiornamento concluso."

msgid "unknown"
msgstr "sconosciuta"

msgid "VabaxOS {version}."
msgstr "VabaxOS {version}."

msgid "Running from the live medium."
msgstr "Avviato dalla chiavetta, senza installazione."

msgid "Installed on this computer."
msgstr "Installato su questo computer."

msgid "Debian testing checked by VabaxOS, date {date}."
msgstr "Debian testing controllata da VabaxOS, data {date}."

msgid "Debian testing day by day, not checked by VabaxOS."
msgstr "Debian testing giorno per giorno, non controllata da VabaxOS."

msgid "VabaxOS archive: on."
msgstr "Archivio di VabaxOS: attivo."

msgid "VabaxOS archive: not set up yet."
msgstr "Archivio di VabaxOS: non ancora attivo."

msgid "Orca is on."
msgstr "Orca è acceso."

msgid "Orca is off."
msgstr "Orca è spento."

msgid "Kokoro, the natural voice"
msgstr "Kokoro, la voce naturale"

msgid "eSpeak NG"
msgstr "eSpeak NG"

msgid "Desktop voice: {name}."
msgstr "Voce del desktop: {name}."

msgid "Chosen at every start, measuring the computer."
msgstr "Scelta a ogni avvio, misurando il computer."

msgid "Unknown voice {name}: use espeak, kokoro or auto."
msgstr "Voce sconosciuta {name}: usa espeak, kokoro o auto."

msgid "The voice did not change."
msgstr "La voce non è cambiata."

msgid "The new voice speaks when Orca starts again: press Super+Alt+S twice."
msgstr "La nuova voce parla quando Orca riparte: premi due volte Super+Alt+S."

msgid "{name} is not installed."
msgstr "{name} non è installato."

msgid "Commands: status, voice, update, report. Example: vabaxctl voice kokoro"
msgstr "Comandi: status, voice, update, report. Esempio: vabaxctl voice kokoro"
