msgid "unknown error"
msgstr "errore sconosciuto"

msgid "Printers and scanners"
msgstr "Stampanti e scanner"

msgid "Search again"
msgstr "Cerca di nuovo"

msgid "Look again for printers and scanners (F5)"
msgstr "Cerca di nuovo stampanti e scanner (F5)"

msgid "Printers"
msgstr "Stampanti"

msgid ""
"Modern printers need nothing to install: turn them on, on the same network "
"as the computer or with the USB cable, then Search again."
msgstr ""
"Le stampanti moderne non hanno bisogno di installare niente: accendile, "
"sulla stessa rete del computer o con il cavo USB, poi Cerca di nuovo."

msgid "Other printers"
msgstr "Altre stampanti"

msgid "Older printers, in GNOME Settings"
msgstr "Stampanti più vecchie, nelle Impostazioni di GNOME"

msgid "Scanners"
msgstr "Scanner"

msgid "Scan and read: the page is saved in Documents, Scans, and read aloud."
msgstr ""
"Scansiona e leggi: il foglio viene salvato in Documenti, Scansioni, e letto "
"ad alta voce."

msgid "Looking for printers and scanners."
msgstr "Cerco stampanti e scanner."

msgid "No printer found."
msgstr "Nessuna stampante trovata."

msgid "default printer"
msgstr "stampante predefinita"

msgid "Print a test page"
msgstr "Stampa una prova"

msgid "Print a test page on {printer}"
msgstr "Stampa una prova su {printer}"

msgid "Make default"
msgstr "Rendi predefinita"

msgid "Make {printer} the default"
msgstr "Rendi predefinita {printer}"

msgid "No scanner found."
msgstr "Nessuno scanner trovato."

msgid "Scan and read"
msgstr "Scansiona e leggi"

msgid "Scan and read with {scanner}"
msgstr "Scansiona e leggi con {scanner}"

msgid "{printers} printers, {scanners} scanners."
msgstr "{printers} stampanti, {scanners} scanner."

msgid "Printing a test page."
msgstr "Stampo una prova."

msgid "Test page sent."
msgstr "Prova inviata alla stampante."

msgid "Not printed: {error}"
msgstr "Non stampato: {error}"

msgid "{printer} is the default printer."
msgstr "{printer} è la stampante predefinita."

msgid "Not changed: {error}"
msgstr "Non cambiato: {error}"

msgid "Scanning: about a minute."
msgstr "Scansione in corso: circa un minuto."

msgid "Not scanned: {error}"
msgstr "Non scansionato: {error}"

msgid "Scanned. The reader opens and reads it."
msgstr "Scansionato. Si apre il lettore, che lo legge."

msgid "VabaxOS test page"
msgstr "Pagina di prova di VabaxOS"

msgid "If you can read this, the printer works."
msgstr "Se riesci a leggere questo, la stampante funziona."

msgid "Scans"
msgstr "Scansioni"

msgid "scan %Y-%m-%d %H-%M-%S.png"
msgstr "scansione %Y-%m-%d %H-%M-%S.png"
