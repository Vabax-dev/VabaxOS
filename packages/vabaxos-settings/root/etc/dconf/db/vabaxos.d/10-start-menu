# VabaxOS Start menu (ADR-0018): ArcMenu, "Redmond" layout (like the
# Windows 7 Start menu), with the VabaxOS logo as its button. Super opens
# it; the GNOME overview stays on Super+A. Defaults: users can change them.
#
# Accessibility (checked with vabaxos-a11y-check in test-boot.sh): the
# button shows the logo and the word "Start", because an icon alone has no
# name for Orca; the power commands are one "Power Off" item that opens a
# menu with written names (Session: Log Out, Lock; System: Restart, Power
# Off, Suspend), like the macOS Apple menu, because ArcMenu's icon-only
# power buttons have no name either.
# A dconf system database instead of a GSettings override, because the
# Debian package 69.2-1 installs its schema only inside the extension.
[org/gnome/shell]
enabled-extensions=['arcmenu@arcmenu.com']

[org/gnome/shell/extensions/arcmenu]
menu-layout='redmond'
menu-button-icon='/usr/share/icons/hicolor/scalable/apps/vabaxos-logo.svg'
position-in-panel='Left'
arcmenu-hotkey=['Super_L']
arcmenu-hotkey-overlay-key-enabled=true
power-options=[(0, true), (1, true), (2, true), (3, true), (4, true), (5, false), (6, false), (7, false)]
update-notifier-enabled=false
menu-button-appearance='Icon_Text'
menu-button-text='Start'
power-display-style='Menu'
