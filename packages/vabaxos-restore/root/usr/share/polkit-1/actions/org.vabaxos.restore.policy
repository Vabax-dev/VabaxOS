<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- VabaxOS: the system restore window runs its helper as administrator. -->
<policyconfig>
  <vendor>VabaxOS</vendor>
  <vendor_url>https://github.com/Vabax-dev/VabaxOS</vendor_url>
  <action id="org.vabaxos.restore">
    <description>Make and restore copies of the system</description>
    <description xml:lang="it">Creare e ripristinare copie del sistema</description>
    <message>The administrator password is needed to change the copies of the system</message>
    <message xml:lang="it">Serve la password di amministratore per cambiare le copie del sistema</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/vabaxos/restore/helper</annotate>
  </action>
</policyconfig>
