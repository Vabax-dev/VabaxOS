msgid "Books and audiobooks"
msgstr "Libri e audiolibri"

msgid ""
"Free books, public domain. Write a title or an author; Down arrow goes to "
"the results."
msgstr ""
"Libri gratuiti, di pubblico dominio. Scrivi un titolo o un autore; Freccia "
"giù va ai risultati."

msgid "Search a book"
msgstr "Cerca un libro"

msgid "Only in Italian"
msgstr "Solo in italiano"

msgid "Search also on Liber Liber"
msgstr "Cerca anche su Liber Liber"

msgid "The Italian library Liber Liber, in the browser"
msgstr "La biblioteca italiana Liber Liber, nel browser"

msgid "Books to read"
msgstr "Libri da leggere"

msgid "From Project Gutenberg."
msgstr "Da Project Gutenberg."

msgid "Audiobooks"
msgstr "Audiolibri"

msgid "From LibriVox, read by volunteers."
msgstr "Da LibriVox, letti da volontari."

msgid "Searching…"
msgstr "Cerco…"

msgid "{source} It does not answer: is Internet connected?"
msgstr "{source} Non risponde: Internet è collegato?"

msgid "{count} found."
msgid_plural "{count} found."
msgstr[0] "{count} trovato."
msgstr[1] "{count} trovati."

msgid ""
"Nothing found for \"{words}\": try Liber Liber, or turn off Only in Italian."
msgstr ""
"Niente trovato per «{words}»: prova Liber Liber, oppure spegni Solo in "
"italiano."

msgid "Books: {books}. Audiobooks: {audio}."
msgstr "Libri: {books}. Audiolibri: {audio}."

msgid "Liber Liber opens in the browser."
msgstr "Liber Liber si apre nel browser."

msgid "The audiobook was not added: {error}"
msgstr "L'audiolibro non è stato aggiunto: {error}"

msgid ""
"{title} added to News and podcasts: open it there; its chapters are the "
"episodes."
msgstr ""
"{title} aggiunto a Notizie e podcast: aprilo lì; i capitoli sono gli "
"episodi."

msgid "Downloading {title}."
msgstr "Scarico {title}."

msgid "{title} was not downloaded: is Internet connected?"
msgstr "{title} non è stato scaricato: Internet è collegato?"

msgid ""
"{title} is in Documents, folder Libri: it opens in the document reader."
msgstr ""
"{title} è in Documenti, cartella Libri: si apre nel lettore di documenti."

msgid " and "
msgstr " e "

msgid "audiobook"
msgstr "audiolibro"

msgid "book"
msgstr "libro"

msgid "{hours} hour"
msgid_plural "{hours} hours"
msgstr[0] "{hours} ora"
msgstr[1] "{hours} ore"

msgid "{minutes} minutes"
msgstr "{minutes} minuti"
