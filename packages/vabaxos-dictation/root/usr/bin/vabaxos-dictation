#!/usr/bin/python3
"""Dictation without Internet: speak, and the text is written (Super+H).

    vabaxos-dictation start      a tone, then it listens to the microphone
    vabaxos-dictation stop       stops listening, a lower tone, and prints
                                 the text that was said (exit 3: nothing)
    vabaxos-dictation cancel     stops listening, writes nothing
    vabaxos-dictation file WAV   the text of a recording

Super+H, as in Windows, is handled by the extension vabaxos-keys of
GNOME Shell: the first time it runs "start", the second "stop", and writes
the text in the program in use, where the cursor is, then says it. The
recognition runs on the computer with whisper.cpp and the Whisper "small"
model: nothing goes on the Internet. It takes from one to a few seconds,
more on slow computers. Listening stops by itself after two minutes.

Say "a capo" (new line) or "nuovo paragrafo" (new paragraph); punctuation
comes by itself from the way you speak.
"""

import gettext
import os
import signal
import subprocess
import sys
import time

from vabaxos_dictation import core

gettext.textdomain("vabaxos-dictation")
_ = gettext.gettext

SOUNDS = os.environ.get("VABAXOS_DICTATION_SOUNDS", "/usr/share/vabaxos/dictation")
MAX_SECONDS = 120


def state_dir():
    base = os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/vabaxos-{os.getuid()}"
    path = os.path.join(base, "vabaxos-dictation")
    os.makedirs(path, mode=0o700, exist_ok=True)
    return path


def paths():
    folder = state_dir()
    return os.path.join(folder, "recorder.pid"), os.path.join(folder, "audio.wav")


def play(name, wait=True):
    sound = os.path.join(SOUNDS, name + ".wav")
    if not os.path.exists(sound):
        return
    for player in (["pw-play", sound], ["paplay", sound], ["aplay", "-q", sound]):
        try:
            process = subprocess.Popen(player, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            continue
        if wait:
            process.wait()
        return


def running_pid():
    pid_file, _audio = paths()
    try:
        with open(pid_file, encoding="utf-8") as f:
            pid = int(f.read().strip())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def start():
    if running_pid():
        print(_("Already listening."))
        return 1
    pid_file, audio = paths()
    for path in (pid_file, audio):
        if os.path.exists(path):
            os.remove(path)
    # The tone first: it must not end up in the recording.
    play("start")
    command = ["timeout", "-s", "INT", str(MAX_SECONDS)] + core.record_command(audio)
    process = subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                               start_new_session=True)
    with open(pid_file, "w", encoding="utf-8") as f:
        f.write(str(process.pid))
    print(_("Listening."))
    return 0


def stop_recorder():
    """Stops the recording so the WAV file is complete; True if one ran."""
    pid = running_pid()
    pid_file, _audio = paths()
    if pid is None:
        if os.path.exists(pid_file):
            os.remove(pid_file)
        return False
    try:
        os.killpg(pid, signal.SIGINT)
    except OSError:
        os.kill(pid, signal.SIGINT)
    for _i in range(50):
        try:
            os.kill(pid, 0)
        except OSError:
            break
        # A child of ours (tests): collect it, or it stays a zombie.
        try:
            if os.waitpid(pid, os.WNOHANG)[0] == pid:
                break
        except ChildProcessError:
            pass
        time.sleep(0.05)
    os.remove(pid_file)
    return True


def stop():
    if not stop_recorder():
        print(_("Not listening."))
        return 1
    _pid, audio = paths()
    play("stop", wait=False)
    try:
        text = core.transcribe(audio, core.user_language())
    except Exception as error:  # noqa: BLE001 - said to the user
        print(_("Dictation failed: {error}").format(error=error), file=sys.stderr)
        return 4
    finally:
        if os.path.exists(audio):
            os.remove(audio)
    if not text:
        return 3
    print(text)
    return 0


def cancel():
    stop_recorder()
    _pid, audio = paths()
    if os.path.exists(audio):
        os.remove(audio)
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0 if argv else 2
    command = argv[0]
    if command == "start":
        return start()
    if command == "stop":
        return stop()
    if command == "cancel":
        return cancel()
    if command == "file" and len(argv) > 1:
        text = core.transcribe(argv[1], argv[2] if len(argv) > 2 else core.user_language())
        if not text:
            return 3
        print(text)
        return 0
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
