#!/usr/bin/env python3
"""Called by scripts/build-packages.sh with the package tree: the sounds of
the controls (usr/share/vabaxos/orca-sounds/<role>.wav), made here so they
are VabaxOS's own (GPL-3.0-or-later), and the Italian catalog inside the
Orca extension (Orca wants it in the extension package, part of the hash
the user approves)."""

import math
import os
import random
import shutil
import struct
import subprocess
import sys
import wave

RATE = 22050
VOLUME = 0.28


def envelope(i, count, attack=0.004, release=0.02):
    a, r = int(RATE * attack) or 1, int(RATE * release) or 1
    return min(1.0, i / a, (count - i) / r)


def tone(freq, seconds, volume=VOLUME, end=None):
    """A sine, gliding to end Hz when given."""
    count = int(RATE * seconds)
    out, phase = [], 0.0
    for i in range(count):
        f = freq if end is None else freq + (end - freq) * i / count
        phase += 2 * math.pi * f / RATE
        out.append(volume * envelope(i, count) * (math.sin(phase) + 0.25 * math.sin(2 * phase)))
    return out


def click(seconds=0.012, volume=VOLUME):
    rng = random.Random(7)
    count = int(RATE * seconds)
    return [volume * (1 - i / count) ** 3 * rng.uniform(-1, 1) for i in range(count)]


def gap(seconds):
    return [0.0] * int(RATE * seconds)


SOUNDS = {
    "push-button": tone(880, 0.035) + gap(0.01) + tone(1175, 0.045),
    "toggle-button": tone(880, 0.03) + gap(0.01) + tone(1175, 0.03) + gap(0.01) + tone(880, 0.03),
    "link": tone(600, 0.09, end=1250),
    "check-box": click() + tone(1500, 0.03),
    "radio-button": tone(1050, 0.06),
    "combo-box": tone(660, 0.03) + tone(880, 0.03) + tone(1100, 0.04),
    "menu": tone(1150, 0.09, end=700),
    "page-tab": tone(440, 0.03) + gap(0.04) + tone(440, 0.03),
    "entry": tone(330, 0.05) + gap(0.01) + click(0.01),
    "slider": tone(400, 0.06, end=800) + tone(800, 0.06, end=400),
    "spin-button": tone(700, 0.035) + tone(900, 0.035) + tone(700, 0.035),
}
SOUNDS["password-text"] = SOUNDS["entry"]
SOUNDS["check-menu-item"] = SOUNDS["check-box"]
SOUNDS["radio-menu-item"] = SOUNDS["radio-button"]
SOUNDS["switch"] = SOUNDS["toggle-button"]


def save(path, samples):
    data = [int(max(-1.0, min(1.0, s)) * 32767) for s in samples]
    with wave.open(path, "wb") as out:
        out.setnchannels(1)
        out.setsampwidth(2)
        out.setframerate(RATE)
        out.writeframes(struct.pack(f"<{len(data)}h", *data))


def main(tree):
    folder = os.path.join(tree, "usr", "share", "vabaxos", "orca-sounds")
    os.makedirs(folder, exist_ok=True)
    for name, samples in sorted(SOUNDS.items()):
        save(os.path.join(folder, name + ".wav"), samples)
    # The extension's own catalog: locale/it/LC_MESSAGES/vabaxos_sounds.mo.
    here = os.path.dirname(os.path.abspath(__file__))
    extension = os.path.join(tree, "usr", "share", "vabaxos", "orca-extensions", "vabaxos_sounds")
    for po in sorted(os.listdir(os.path.join(here, "extension-po"))):
        if not po.endswith(".po"):
            continue
        lang = po[:-3]
        target = os.path.join(extension, "locale", lang, "LC_MESSAGES", "vabaxos_sounds.mo")
        os.makedirs(os.path.dirname(target), exist_ok=True)
        source = os.path.join(here, "extension-po", po)
        if shutil.which("msgfmt"):
            subprocess.run(["msgfmt", "--check", "-o", target, source], check=True)
        else:
            subprocess.run([sys.executable, os.path.join(os.environ["REPO"], "scripts", "lib", "po2mo.py"),
                            source, target], check=True)


if __name__ == "__main__":
    main(sys.argv[1])
