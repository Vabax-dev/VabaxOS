#!/usr/bin/python3
"""The check of the computer: sound, network, battery, Braille, Bluetooth,
microphone, camera, memory and disk, said aloud.

    vabaxos-checkup               the window
    vabaxos-checkup --say         says the summary, without a window
    vabaxos-checkup --first-run   once, at the first login of the installed
                                  system; then the lessons of the keys

The window lists first what to look at, then what works. F5 checks again;
Ctrl+C copies the result, to send it to whoever helps you.
"""

import gettext
import os
import shutil
import subprocess
import sys
import threading

import vabaxos_checkup as vc

gettext.textdomain("vabaxos-checkup")
_ = gettext.gettext


def present(text):
    print(text, flush=True)
    try:
        from gi.repository import Gio, GLib
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        bus.call_sync("org.gnome.Orca.Service", "/org/gnome/Orca/Service", "org.gnome.Orca.Service",
                      "PresentMessage", GLib.Variant("(s)", (text,)), None, Gio.DBusCallFlags.NONE, 2000, None)
    except Exception:  # noqa: BLE001 - printed anyway
        pass


def window_classes(speak=present, checker=vc.run_checks, after_close=None):
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, GLib, Gtk

    class CheckupWindow(Adw.ApplicationWindow):

        def __init__(self, app):
            super().__init__(application=app, title=_("Check of the computer"))
            self.set_default_size(640, 620)
            self.items = []
            self.rows = []
            self.toasts = Adw.ToastOverlay()
            view = Adw.ToolbarView()
            view.add_top_bar(Adw.HeaderBar())
            page = Adw.PreferencesPage()
            self.bad = Adw.PreferencesGroup(title=_("To look at"))
            self.good = Adw.PreferencesGroup(title=_("What the computer has"))
            buttons = Gtk.Box(spacing=8, homogeneous=True)
            again = Gtk.Button(label=_("Check again"))
            again.set_tooltip_text(_("Check the computer again (F5)"))
            again.connect("clicked", lambda *_a: self.check())
            copy = Gtk.Button(label=_("Copy the result"))
            copy.set_tooltip_text(_("Copy the result, to send it to whoever helps you (Ctrl+C)"))
            copy.connect("clicked", lambda *_a: self.copy())
            buttons.append(again)
            buttons.append(copy)
            top = Adw.PreferencesGroup(description=_("What this computer has, and whether it works for VabaxOS."))
            top.add(buttons)
            page.add(top)
            page.add(self.bad)
            page.add(self.good)
            view.set_content(page)
            self.toasts.set_child(view)
            self.set_content(self.toasts)
            keys = Gtk.ShortcutController(scope=Gtk.ShortcutScope.MANAGED)
            for accel, action in (("F5", self.check), ("<Control>c", self.copy), ("Escape", self.close)):
                keys.add_shortcut(Gtk.Shortcut.new(Gtk.ShortcutTrigger.parse_string(accel),
                                                   Gtk.CallbackAction.new(lambda *_a, act=action: act() or True)))
            self.add_controller(keys)
            if after_close:
                self.connect("close-request", lambda *_a: after_close() or False)
            self.check()

        def say(self, text):
            self.toasts.add_toast(Adw.Toast.new(text))
            speak(text)
            return False

        def check(self):
            self.say(_("Checking the computer."))

            def work():
                try:
                    items = checker()
                except Exception as error:  # noqa: BLE001
                    items = [vc.Item("error", _("Check"), vc.PROBLEM, str(error))]
                GLib.idle_add(self.show, items)
            threading.Thread(target=work, daemon=True).start()

        def show(self, items):
            for group, row in self.rows:
                group.remove(row)
            self.rows = []
            self.items = items
            bad = vc.problems(items)
            self.bad.set_visible(bool(bad))
            for item in bad + [i for i in items if i not in bad]:
                group = self.bad if item in bad else self.good
                row = Adw.ActionRow(title=item.area, subtitle=item.sentence, subtitle_lines=0)
                row.set_focusable(True)
                group.add(row)
                self.rows.append((group, row))
            if self.rows:
                self.rows[0][1].grab_focus()
            self.say(vc.summary(items))
            return False

        def copy(self):
            if self.items:
                self.get_clipboard().set("\n".join(i.text() for i in self.items))
                self.say(_("Result copied: paste it with Ctrl+V."))

    class CheckupApp(Adw.Application):
        def __init__(self):
            super().__init__(application_id="org.vabaxos.Checkup")
            self.connect("activate", lambda app: (app.get_active_window() or CheckupWindow(app)).present())

    return CheckupApp, CheckupWindow


def first_run_marker():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "vabaxos", "checkup-done")


def live_system():
    try:
        with open("/proc/cmdline", encoding="utf-8") as f:
            return "boot=live" in f.read().split()
    except OSError:
        return False


def start_lessons():
    """The lessons of the keys come after the check: never two windows
    and two voices at once."""
    if shutil.which("vabaxos-lessons"):
        subprocess.Popen(["vabaxos-lessons", "--first-run"], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main(argv):
    if "--help" in argv or "-h" in argv:
        print(__doc__)
        return 0
    if "--say" in argv:
        present(vc.summary(vc.run_checks()))
        return 0
    after_close = None
    if "--first-run" in argv:
        marker = first_run_marker()
        if live_system() or os.path.exists(marker):
            return 0
        os.makedirs(os.path.dirname(marker), exist_ok=True)
        open(marker, "w").close()
        after_close = start_lessons
    app_class, _window = window_classes(after_close=after_close)
    return app_class().run([argv[0]])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
