msgstr "Elimina: {source}"

msgid "Source deleted."
msgstr "Fonte eliminata."

msgid ""
"Write the address of a news site or a podcast, for example ilpost.it, then "
"Enter. Or choose a suggestion."
msgstr ""
"Scrivi l'indirizzo di un sito di notizie o di un podcast, per esempio "
"ilpost.it, poi Invio. Oppure scegli un suggerimento."

msgid "Address"
msgstr "Indirizzo"

msgid "Add {source}"
msgstr "Aggiungi {source}"

msgid "Cancel"
msgstr "Annulla"

msgid "Add"
msgstr "Aggiungi"

