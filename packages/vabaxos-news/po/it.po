msgid "News and podcasts"
msgstr "Notizie e podcast"

msgid "Sources"
msgstr "Fonti"

msgid "Enter opens a source; Ctrl+N adds one."
msgstr "Invio apre una fonte; Ctrl+N ne aggiunge una."

msgid "Add a source"
msgstr "Aggiungi una fonte"

msgid "A news site or a podcast (Ctrl+N)"
msgstr "Un sito di notizie o un podcast (Ctrl+N)"

msgid "No source yet: Ctrl+N adds one."
msgstr "Nessuna fonte per ora: Ctrl+N ne aggiunge una."

