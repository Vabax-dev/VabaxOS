msgstr "lunedì"

msgid "Tuesday"
msgstr "martedì"

msgid "Wednesday"
msgstr "mercoledì"

msgid "Thursday"
msgstr "giovedì"

msgid "Friday"
msgstr "venerdì"

msgid "Saturday"
msgstr "sabato"

msgid "Sunday"
msgstr "domenica"

msgid "January"
msgstr "gennaio"

msgid "February"
msgstr "febbraio"

msgid "March"
msgstr "marzo"

msgid "April"
msgstr "aprile"

msgid "May"
msgstr "maggio"

msgid "June"
msgstr "giugno"

msgid "July"
msgstr "luglio"

msgid "August"
msgstr "agosto"

msgid "September"
msgstr "settembre"

msgid "October"
msgstr "ottobre"

msgid "November"
msgstr "novembre"

msgid "December"
msgstr "dicembre"

msgid "Today"
msgstr "Oggi"

msgid "Tomorrow"
msgstr "Domani"

msgid "The day after tomorrow"
msgstr "Dopodomani"

msgid "{weekday} {day} {month}"
msgstr "{weekday} {day} {month}"

msgid "one hour"
msgid_plural "{hours} hours"
msgstr[0] "un'ora"
msgstr[1] "{hours} ore"

msgid "{hours} h {minutes} min"
msgstr "{hours} ore e {minutes} minuti"

msgid "one minute"
msgid_plural "{minutes} minutes"
msgstr[0] "un minuto"
msgstr[1] "{minutes} minuti"

msgid "all day"
msgstr "tutto il giorno"

msgid "All day"
msgstr "Tutto il giorno"

msgid "{day} at {time}"
msgstr "{day} alle {time}"

msgid "No appointments today and tomorrow."
msgstr "Nessun appuntamento oggi e domani."

msgid "One appointment."
msgid_plural "{count} appointments."
msgstr[0] "Un appuntamento."
msgstr[1] "{count} appuntamenti."

msgid "Now: {title}{place}."
msgstr "Adesso: {title}{place}."

msgid "In one minute: {title}{place}."
msgid_plural "In {minutes} minutes: {title}{place}."
msgstr[0] "Tra un minuto: {title}{place}."
msgstr[1] "Tra {minutes} minuti: {title}{place}."
