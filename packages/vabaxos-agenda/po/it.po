msgid "Agenda"
msgstr "Agenda"

msgid "New appointment"
msgstr "Nuovo appuntamento"

msgid "New appointment (Ctrl+N)"
msgstr "Nuovo appuntamento (Ctrl+N)"

msgid "Accounts"
msgstr "Account"

msgid "Add Google or Microsoft 365 / Outlook, in GNOME's Online Accounts"
msgstr ""
"Aggiungi Google o Microsoft 365 / Outlook, negli Account online di GNOME"

msgid "Reading the calendars…"
msgstr "Leggo i calendari…"

msgid "The calendars cannot be read: {error}"
msgstr "Non riesco a leggere i calendari: {error}"

msgid "{count} appointment in the next two weeks. Ctrl+N adds one."
msgid_plural "{count} appointments in the next two weeks. Ctrl+N adds one."
msgstr[0] ""
"{count} appuntamento nelle prossime due settimane. Ctrl+N ne aggiunge uno."
msgstr[1] ""
"{count} appuntamenti nelle prossime due settimane. Ctrl+N ne aggiunge uno."

msgid "No appointments in the next two weeks. Ctrl+N adds one."
msgstr ""
"Nessun appuntamento nelle prossime due settimane. Ctrl+N ne aggiunge uno."

msgid "Untitled"
msgstr "Senza titolo"

msgid "Close"
msgstr "Chiudi"

msgid "Delete"
msgstr "Elimina"

msgid "Delete the appointment?"
msgstr "Eliminare l'appuntamento?"

msgid "Cancel"
msgstr "Annulla"

msgid "The appointment was not deleted: {error}"
msgstr "L'appuntamento non è stato eliminato: {error}"

msgid "Deleted: {title}."
msgstr "Eliminato: {title}."

msgid ""
"Write what and when, for example \"domani alle 10:30 dentista\" or \"venerdì"
" alle 18 riunione\"."
msgstr ""
"Scrivi cosa e quando, per esempio «domani alle 10:30 dentista» o «venerdì "
"alle 18 riunione»."

msgid "What and when"
msgstr "Cosa e quando"

msgid "Where (if you want)"
msgstr "Dove (se vuoi)"

msgid "Calendar"
msgstr "Calendario"

msgid "Add"
msgstr "Aggiungi"

msgid "I did not find the time: write for example \"domani alle 10:30 dentista\"."
msgstr ""
"Non ho trovato l'ora: scrivi per esempio «domani alle 10:30 dentista»."

msgid "Is it right?"
msgstr "È giusto?"

msgid "No, write again"
msgstr "No, riscrivi"

msgid "Yes, add it"
msgstr "Sì, aggiungilo"

msgid "The appointment was not added: {error}"
msgstr "L'appuntamento non è stato aggiunto: {error}"

msgid "Added: {appointment}."
msgstr "Aggiunto: {appointment}."

