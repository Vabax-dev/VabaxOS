#!/usr/bin/python3
"""Telegram for Orca: AccessGram, downloaded on request.

    vabaxos-accessgram

The window says what AccessGram is (a Telegram program made for screen
readers, in English, young), downloads the version VabaxOS has checked,
opens it, removes it, and opens my.telegram.org, where Telegram gives the
"API ID" and "API hash" that AccessGram asks the first time.
"""

import gettext
import subprocess
import sys
import threading

from vabaxos_communication import accessgram

gettext.textdomain("vabaxos-communication")
_ = gettext.gettext


def present(text):
    try:
        from gi.repository import Gio, GLib
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        bus.call_sync("org.gnome.Orca.Service", "/org/gnome/Orca/Service", "org.gnome.Orca.Service",
                      "PresentMessage", GLib.Variant("(s)", (text,)), None, Gio.DBusCallFlags.NONE, 2000, None)
    except Exception:  # noqa: BLE001 - shown in the window anyway
        pass


def start_accessgram():
    import os
    env = dict(os.environ, PYTHONPATH=accessgram.code_dir())
    subprocess.Popen([sys.executable, "-m", "accessgram"], env=env, start_new_session=True)


def open_url(url):
    from gi.repository import Gio
    Gio.AppInfo.launch_default_for_uri(url, None)


def window_classes(speak=present, program=accessgram, starter=start_accessgram, browser=open_url):
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, GLib, Gtk

    def run(work, done):
        def thread():
            try:
                result = work()
            except Exception as error:  # noqa: BLE001 - said to the user
                result = error
            GLib.idle_add(lambda: done(result) and False)
        threading.Thread(target=thread, daemon=True).start()

    class AccessGramWindow(Adw.ApplicationWindow):

        def __init__(self, app):
            super().__init__(application=app, title=_("Telegram for Orca"))
            self.set_default_size(620, 560)
            self.toasts = Adw.ToastOverlay()
            view = Adw.ToolbarView()
            view.add_top_bar(Adw.HeaderBar())
            page = Adw.PreferencesPage()
            about = Adw.PreferencesGroup(title=_("AccessGram"), description=_(
                "A Telegram program made for screen readers, free (MIT). It is young and in English; it is not "
                "made by VabaxOS. Telegram Web, in the Start menu, works too."))
            self.status = Adw.ActionRow(title="", title_lines=0)
            self.status.set_focusable(True)
            about.add(self.status)
            buttons = Gtk.Box(spacing=8, margin_top=12, homogeneous=True)
            self.main_button = Gtk.Button()
            self.main_button.connect("clicked", lambda *_a: self.main_action())
            self.remove_button = Gtk.Button(label=_("Remove"))
            self.remove_button.connect("clicked", lambda *_a: self.remove())
            buttons.append(self.main_button)
            buttons.append(self.remove_button)
            about.add(buttons)
            page.add(about)
            keys = Adw.PreferencesGroup(title=_("The first time"), description=_(
                "AccessGram asks an API ID and an API hash: Telegram gives them to each person. Open "
                "my.telegram.org, enter with your phone number and the code Telegram sends you, choose API "
                "development tools, fill in the form (any name for the application), then copy the two values."))
            site = Gtk.Button(label=_("Open my.telegram.org"), margin_top=8)
            site.set_tooltip_text(_("In the browser"))
            site.connect("clicked", lambda *_a: self.open_site())
            keys.add(site)
            page.add(keys)
            view.set_content(page)
            self.toasts.set_child(view)
            self.set_content(self.toasts)
            self.refresh()
            GLib.idle_add(lambda: self.status.grab_focus() and False)

        def say(self, text):
            self.toasts.add_toast(Adw.Toast.new(text))
            speak(text)
            return False

        def refresh(self):
            if program.installed():
                self.status.set_title(_("Installed. Open it from here or from the Start menu."))
                self.main_button.set_label(_("Open AccessGram"))
                self.remove_button.set_visible(True)
            else:
                self.status.set_title(_("Not installed: about 1 MB, from GitHub, the version checked by VabaxOS."))
                self.main_button.set_label(_("Download and install"))
                self.remove_button.set_visible(False)
            self.main_button.set_sensitive(True)

        def main_action(self):
            if program.installed():
                starter()
                self.say(_("AccessGram opens."))
                return
            self.main_button.set_sensitive(False)
            self.say(_("Downloading AccessGram."))

            def done(result):
                self.refresh()
                if isinstance(result, Exception):
                    if str(result) == "damaged":
                        self.say(_("The download is not the version VabaxOS checked: nothing installed."))
                    else:
                        self.say(_("Download failed: is Internet connected? {error}").format(error=result))
                    return
                self.say(_("AccessGram installed: it is also in the Start menu. Open it with Open AccessGram."))
                self.main_button.grab_focus()
            run(program.install, done)

        def remove(self):
            program.remove()
            self.refresh()
            self.say(_("AccessGram removed. Your Telegram session stays in AccessGram's folder."))

        def open_site(self):
            browser(program.MY_TELEGRAM)
            self.say(_("my.telegram.org opens in the browser."))

    class AccessGramApp(Adw.Application):
        def __init__(self):
            super().__init__(application_id="org.vabaxos.AccessGramSetup")
            self.connect("activate", lambda app: (app.get_active_window() or AccessGramWindow(app)).present())

    return AccessGramApp, AccessGramWindow


def main(argv):
    if "--help" in argv or "-h" in argv:
        print(__doc__)
        return 0
    app_class, _window = window_classes()
    return app_class().run([argv[0]])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
