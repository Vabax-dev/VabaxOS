#!/usr/bin/python3
"""Welcome to VabaxOS: a spoken menu on the text console, before the desktop.

ADR-0016. It runs as root on tty1, started by vabaxos-welcome.service.
First the language, asked in English (skipped if chosen in the boot menu),
then the mode: try VabaxOS, install VabaxOS (when the installer is on the
medium), accessibility (voice, keyboard, large text, high contrast, zoom,
sticky keys: they also apply to the desktop), restart, shut down.

Keys: up and down arrows move and read the item, Enter confirms, Esc goes
back, F1 repeats the message. It never chooses by itself: after 30 seconds
without keys it repeats the message once, then waits.

Speech: espeak-ng through the user's PipeWire when it runs (in the live system
it starts at boot), otherwise played with aplay on the sound card; a key press
interrupts it.
With the boot option vabaxos.voice=off the menu is shown without speech.

Tests: with VABAXOS_WELCOME_DRY_RUN=FILE nothing is spoken and nothing is
changed on the system; what would be said and done is written to FILE,
one line each ("say <lang>: <text>", "do <action>").
"""

import gettext
import glob
import os
import select
import signal
import stat
import subprocess
import sys
import termios
import tty

LOCALE_DIR = os.environ.get("VABAXOS_WELCOME_LOCALE_DIR", "/usr/share/locale")
DOMAIN = "vabaxos-welcome"
REPEAT_AFTER = 30  # seconds without keys before the message is repeated once

# code, locale, keyboard layout, name written in the language itself
LANGUAGES = [
    ("en", "en_US.UTF-8", "us", "English"),
    ("it", "it_IT.UTF-8", "it", "Italiano"),
]
KEYBOARDS = [("us", "English (US)"), ("it", "Italiano")]
RATES = [120, 150, 175, 210, 250, 300, 350]  # words per minute for espeak-ng
DEFAULT_RATE = 2
# Speakup rate (0-9) and Orca rate (0-100, 50 is the default) for each entry
# of RATES, so the console and the desktop speak as fast as the welcome.
SPEAKUP_RATES = [2, 3, 4, 5, 6, 7, 8]
ORCA_RATES = [30, 40, 50, 60, 70, 80, 90]

DRY_RUN = os.environ.get("VABAXOS_WELCOME_DRY_RUN")

# Key names returned by read_key().
UP, DOWN, ENTER, ESC, F1, TIMEOUT = "up", "down", "enter", "esc", "f1", "timeout"


def record(line):
    with open(DRY_RUN, "a", encoding="utf-8") as f:
        f.write(line + "\n")


def run(*command):
    """Runs a system command, or only records it in a dry run."""
    if DRY_RUN:
        record("do " + " ".join(command))
        return
    subprocess.run(list(command), check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def kernel_options():
    if DRY_RUN:
        return dict(w.split("=", 1) for w in os.environ.get("VABAXOS_WELCOME_OPTIONS", "").split())
    try:
        with open("/proc/cmdline", encoding="utf-8") as f:
            words = f.read().split()
    except OSError:
        words = []
    return dict(w.split("=", 1) if "=" in w else (w, "") for w in words)


def sound_server():
    """The PulseAudio socket of a user's PipeWire, or None.

    Only in the live system, where the live user's PipeWire starts at boot
    and holds the sound card. In an installed system the login screen's
    PipeWire may already be running when the welcome starts (systemd starts
    its manager early), but it gets the sound card only when the login
    screen appears: before that, speech sent to it would be silent, so the
    welcome plays on the sound card itself (test-install.sh, 2026-09-25)."""
    if not live_system():
        return None
    for socket in sorted(glob.glob("/run/user/*/pulse/native")):
        if stat.S_ISSOCK(os.stat(socket).st_mode):
            return socket
    return None


class Speaker:
    """Speaks with espeak-ng; new speech interrupts the previous one.

    say() takes a list of (text, language) parts, spoken in order, each
    with the voice of its language. All parts run in one process group,
    so a key press stops them all at once.
    """

    def __init__(self, enabled):
        self.enabled = enabled
        self.rate = DEFAULT_RATE
        self.process = None

    def stop(self):
        if self.process and self.process.poll() is None:
            os.killpg(self.process.pid, signal.SIGTERM)
            self.process.wait()
        self.process = None

    def say(self, parts):
        self.stop()
        if not self.enabled:
            return
        if DRY_RUN:
            for text, lang in parts:
                record(f"say {lang}: {text}")
            return
        rate = str(RATES[self.rate])
        socket = sound_server()
        env = dict(os.environ)
        if socket:
            # One sound server for everything: the user's PipeWire, which
            # console speech and Orca use too (in the live system it starts
            # at boot, before the welcome).
            env["PULSE_SERVER"] = "unix:" + socket
            player = ""
        else:
            # No sound server: espeak-ng plays only through PulseAudio, and
            # ALSA's default device leads there too (pipewire-alsa). Write
            # WAV and play it with aplay on the sound card itself.
            player = " --stdout | aplay -q -D sysdefault"
        script = " && ".join(
            f'espeak-ng -v {lang} -s {rate} -- "${i + 1}"{player}'
            for i, (_, lang) in enumerate(parts)
        )
        try:
            self.process = subprocess.Popen(
                ["sh", "-c", script, "vabaxos-welcome"] + [text for text, _ in parts],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
                env=env,
            )
        except OSError:
            self.enabled = False

    def wait(self):
        if self.process:
            self.process.wait()


class Console:
    """Raw keyboard input and plain text output on the terminal."""

    def __init__(self):
        self.fd = sys.stdin.fileno()
        self.saved = termios.tcgetattr(self.fd)
        tty.setcbreak(self.fd)

    def restore(self):
        termios.tcsetattr(self.fd, termios.TCSADRAIN, self.saved)

    def read_key(self, timeout):
        ready, _, _ = select.select([self.fd], [], [], timeout)
        if not ready:
            return TIMEOUT
        data = os.read(self.fd, 16)
        # A lone Esc; escape sequences arrive together in one read.
        if data == b"\x1b":
            ready, _, _ = select.select([self.fd], [], [], 0.05)
            if not ready:
                return ESC
            data += os.read(self.fd, 16)
        if data in (b"\r", b"\n"):
            return ENTER
        if data in (b"\x1b[A", b"\x1bOA"):
            return UP
        if data in (b"\x1b[B", b"\x1bOB"):
            return DOWN
        if data in (b"\x1b[[A", b"\x1bOP", b"\x1b[11~"):
            return F1
        return None

    @staticmethod
    def show(title, message, items, selected):
        lines = ["\x1b[H\x1b[2J", title, "", message, ""]
        for i, item in enumerate(items):
            lines.append(("> " if i == selected else "  ") + item)
        sys.stdout.write("\n".join(lines) + "\n")
        sys.stdout.flush()


def choose(console, speaker, title, message, items, item_langs, selected=0):
    """Shows a menu and returns the index chosen with Enter, or None for Esc.

    message: list of (text, language) parts, spoken in order.
    item_langs: the language of each item, so that it is read with its voice.
    """
    text = " ".join(t for t, _ in message)

    def announce():
        speaker.say(message + [(items[selected], item_langs[selected])])

    console.show(title, text, items, selected)
    announce()
    repeated = False
    while True:
        key = console.read_key(None if repeated else REPEAT_AFTER)
        if key == TIMEOUT:
            repeated = True
            announce()
        elif key in (UP, DOWN):
            selected = (selected + (1 if key == DOWN else -1)) % len(items)
            console.show(title, text, items, selected)
            speaker.say([(items[selected], item_langs[selected])])
        elif key == ENTER:
            speaker.stop()
            return selected
        elif key == ESC:
            speaker.stop()
            return None
        elif key == F1:
            announce()


def translation(code):
    return gettext.translation(DOMAIN, LOCALE_DIR, languages=[code], fallback=True).gettext


def apply_language(code):
    """Makes the chosen language the system language, for the desktop too."""
    locale = next(loc for c, loc, _, _ in LANGUAGES if c == code)
    layout = next(kb for c, _, kb, _ in LANGUAGES if c == code)
    if DRY_RUN:
        record(f"do set LANG={locale}")
    else:
        with open("/etc/default/locale", "w", encoding="utf-8") as f:
            f.write(f"LANG={locale}\n")
    run("systemctl", "set-environment", f"LANG={locale}")
    apply_keyboard(layout)


def apply_keyboard(layout):
    run("localectl", "set-x11-keymap", layout)
    run("setupcon", "--force")


def apply_rate(rate):
    """Console speech speed, used by espeakup when it starts."""
    run("modprobe", "speakup_soft")
    if DRY_RUN:
        record(f"do speakup rate {SPEAKUP_RATES[rate]}")
        return
    try:
        with open("/sys/accessibility/speakup/soft/rate", "w", encoding="ascii") as f:
            f.write(str(SPEAKUP_RATES[rate]))
    except OSError:
        pass


def step_language(console, speaker):
    """Returns the chosen language code.

    The message is in English only, as in other distributions; each language
    in the list is read in its own language, so adding a language only needs
    its name (Vabax, 2026-09-24).
    """
    message = [
        ("Welcome to VabaxOS. Use the arrow keys to choose your language, then press Enter.", "en"),
    ]
    items = [name for _, _, _, name in LANGUAGES]
    langs = [code for code, _, _, _ in LANGUAGES]
    while True:
        index = choose(console, speaker, "VabaxOS", message, items, langs)
        if index is not None:
            return langs[index]


class Settings:
    """What the person chose in the welcome, for the console and the desktop."""

    def __init__(self, lang):
        self.lang = lang
        self.layout = next(kb for c, _, kb, _ in LANGUAGES if c == lang)
        self.large_text = False
        self.high_contrast = False
        self.zoom = False
        self.sticky_keys = False


def apply_console_font(large):
    """Large text on the text consoles: Terminus 16x32 instead of 8x16."""
    face, size = ("TerminusBold", "16x32") if large else ("Fixed", "8x16")
    if DRY_RUN:
        record(f"do console font {face} {size}")
        return
    path = "/etc/default/console-setup"
    try:
        with open(path, encoding="utf-8") as f:
            lines = [line for line in f if not line.startswith(("FONTFACE=", "FONTSIZE="))]
    except OSError:
        lines = []
    lines += [f'FONTFACE="{face}"\n', f'FONTSIZE="{size}"\n']
    with open(path, "w", encoding="utf-8") as f:
        f.writelines(lines)
    run("setupcon", "--force")


def desktop_override(settings, rate):
    """GSettings defaults for the desktop and Orca, from the welcome's choices.

    Written as a schema override, so they apply to the live user and to the
    login screen; people can still change them later.
    """
    lines = ["# Written by vabaxos-welcome (ADR-0016): choices made before the desktop."]
    lines += ["[org.gnome.Orca.Voice]", f"rate={ORCA_RATES[rate]}"]
    if settings.large_text:
        lines += ["[org.gnome.desktop.interface]", "text-scaling-factor=1.5", "cursor-size=48"]
    if settings.high_contrast:
        lines += ["[org.gnome.desktop.a11y.interface]", "high-contrast=true"]
    if settings.zoom:
        lines += ["[org.gnome.desktop.a11y.applications]", "screen-magnifier-enabled=true",
                  "[org.gnome.desktop.a11y.magnifier]", "mag-factor=2.0"]
    if settings.sticky_keys:
        lines += ["[org.gnome.desktop.a11y.keyboard]", "stickykeys-enable=true"]
    return "\n".join(lines) + "\n"


def apply_desktop(settings, rate):
    text = desktop_override(settings, rate)
    if DRY_RUN:
        for line in text.splitlines()[1:]:
            record(f"do gsettings {line}")
        return
    schemas = "/usr/share/glib-2.0/schemas"
    with open(f"{schemas}/96_vabaxos-welcome.gschema.override", "w", encoding="utf-8") as f:
        f.write(text)
    run("glib-compile-schemas", schemas)


def state(_, on):
    return _("on") if on else _("off")


def step_accessibility(console, speaker, settings):
    """Voice, keyboard, view and typing, before the desktop."""
    lang = settings.lang
    _ = translation(lang)
    selected = 0
    while True:
        keyboard_name = next(name for kb, name in KEYBOARDS if kb == settings.layout)
        items = [
            _("Slower voice"),
            _("Faster voice"),
            _("Keyboard: {name}").format(name=keyboard_name),
            _("Large text: {state}").format(state=state(_, settings.large_text)),
            _("High contrast: {state}").format(state=state(_, settings.high_contrast)),
            _("Zoom: {state}").format(state=state(_, settings.zoom)),
            _("Sticky keys: {state}").format(state=state(_, settings.sticky_keys)),
            _("Back"),
        ]
        message = [(_("Use the arrow keys to choose, then press Enter."), lang)]
        index = choose(console, speaker, _("Accessibility"), message,
                       items, [lang] * len(items), selected)
        if index is None or index == len(items) - 1:
            return
        selected = index
        if index == 0:
            speaker.rate = max(0, speaker.rate - 1)
        elif index == 1:
            speaker.rate = min(len(RATES) - 1, speaker.rate + 1)
        elif index == 2:
            codes = [kb for kb, _ in KEYBOARDS]
            settings.layout = codes[(codes.index(settings.layout) + 1) % len(codes)]
            apply_keyboard(settings.layout)
        elif index == 3:
            settings.large_text = not settings.large_text
            apply_console_font(settings.large_text)
        elif index == 4:
            settings.high_contrast = not settings.high_contrast
        elif index == 5:
            settings.zoom = not settings.zoom
        elif index == 6:
            settings.sticky_keys = not settings.sticky_keys


def installer_available():
    """The Debian installer is on the live medium (live-build --debian-installer)."""
    if DRY_RUN:
        return os.environ.get("VABAXOS_WELCOME_INSTALLER") == "1"
    return os.path.exists("/run/live/medium/install")


def step_install(console, speaker, lang):
    """The installer starts from the boot menu: explain how, offer to restart."""
    _ = translation(lang)
    message = [(_("To install VabaxOS, restart the computer. After the two beeps of the "
                  "boot menu, press I for the installer with voice."), lang)]
    items = [_("Restart now"), _("Back")]
    index = choose(console, speaker, _("Install VabaxOS"), message, items, [lang] * 2)
    if index == 0:
        speaker.say([(_("Restarting."), lang)])
        speaker.wait()
        run("systemctl", "reboot")
        sys.exit(0)


def live_system():
    """Running from the live medium, where every start is the first one."""
    if DRY_RUN:
        return os.environ.get("VABAXOS_WELCOME_LIVE", "1") == "1"
    return os.path.isdir("/run/live/medium")


DONE_FILE = "/var/lib/vabaxos/welcome-done"


def mark_done():
    """In an installed system the welcome runs only at the first start
    (ADR-0016, point 7): its service has ConditionPathExists=!DONE_FILE."""
    if live_system():
        return
    if DRY_RUN:
        record(f"do touch {DONE_FILE}")
        return
    os.makedirs(os.path.dirname(DONE_FILE), exist_ok=True)
    with open(DONE_FILE, "w", encoding="utf-8") as f:
        f.write("VabaxOS welcome completed\n")


def step_mode(console, speaker, settings):
    """Returns True to continue to the desktop; restart and shut down do not return."""
    lang = settings.lang
    _ = translation(lang)
    while True:
        actions = ["try"] + (["install"] if installer_available() else []) + ["a11y", "restart", "halt"]
        start = _("Try VabaxOS") if live_system() else _("Start VabaxOS")
        names = {"try": start, "install": _("Install VabaxOS"),
                 "a11y": _("Accessibility"), "restart": _("Restart"), "halt": _("Shut down")}
        items = [names[a] for a in actions]
        message = [(_("Welcome to VabaxOS. Use the arrow keys to choose the mode of configuration or use, then press Enter."), lang)]
        index = choose(console, speaker, _("Welcome to VabaxOS"), message,
                       items, [lang] * len(items))
        if index is None:
            return False  # back to the language
        action = actions[index]
        if action == "try":
            return True
        if action == "install":
            step_install(console, speaker, lang)
        elif action == "a11y":
            step_accessibility(console, speaker, settings)
        elif action == "restart":
            speaker.say([(_("Restarting."), lang)])
            speaker.wait()
            run("systemctl", "reboot")
            sys.exit(0)
        elif action == "halt":
            speaker.say([(_("Shutting down."), lang)])
            speaker.wait()
            run("systemctl", "poweroff")
            sys.exit(0)


def main():
    options = kernel_options()
    speaker = Speaker(options.get("vabaxos.voice", "on") != "off")
    chosen = options.get("vabaxos.lang")
    if chosen not in [code for code, _, _, _ in LANGUAGES]:
        chosen = None
    console = Console()
    try:
        while True:
            lang = chosen or step_language(console, speaker)
            apply_language(lang)
            settings = Settings(lang)
            if step_mode(console, speaker, settings):
                break
            if chosen:
                # Language chosen in the boot menu: Esc offers the list anyway.
                chosen = None
        apply_rate(speaker.rate)
        apply_desktop(settings, speaker.rate)
        mark_done()
        _ = translation(lang)
        speaker.say([(_("Starting the desktop. Please wait."), lang)])
        speaker.wait()
    finally:
        speaker.stop()
        console.restore()
        sys.stdout.write("\x1b[H\x1b[2J")
        sys.stdout.flush()


if __name__ == "__main__":
    main()
