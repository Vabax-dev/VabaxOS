msgid "Welcome to VabaxOS"
msgstr "Benvenuto in VabaxOS"

msgid "Welcome to VabaxOS. Use the arrow keys to choose the mode of configuration or use, then press Enter."
msgstr "Benvenuto in VabaxOS. Usa le frecce per scegliere la modalità di configurazione o di utilizzo, poi premi Invio."

msgid "Try VabaxOS"
msgstr "Prova VabaxOS"

msgid "Accessibility"
msgstr "Accessibilità"

msgid "Restart"
msgstr "Riavvia"

msgid "Shut down"
msgstr "Spegni"

msgid "Use the arrow keys to choose, then press Enter."
msgstr "Usa le frecce per scegliere, poi premi Invio."

msgid "Slower voice"
msgstr "Voce più lenta"

msgid "Faster voice"
msgstr "Voce più veloce"

msgid "Keyboard: {name}"
msgstr "Tastiera: {name}"

msgid "Back"
msgstr "Indietro"

msgid "Restarting."
msgstr "Riavvio in corso."

msgid "Shutting down."
msgstr "Spegnimento in corso."

msgid "Starting the desktop. Please wait."
msgstr "Avvio del desktop. Attendi."

msgid "Large text: {state}"
msgstr "Testo grande: {state}"

msgid "High contrast: {state}"
msgstr "Alto contrasto: {state}"

msgid "Zoom: {state}"
msgstr "Zoom: {state}"

msgid "Sticky keys: {state}"
msgstr "Tasti permanenti: {state}"

msgid "on"
msgstr "attivo"

msgid "off"
msgstr "spento"

msgid "Install VabaxOS"
msgstr "Installa VabaxOS"

msgid "To install VabaxOS, restart the computer. After the two beeps of the boot menu, press I for the installer with voice."
msgstr "Per installare VabaxOS, riavvia il computer. Dopo i due bip del menu di avvio, premi I per l'installer con la voce."

msgid "Restart now"
msgstr "Riavvia ora"

msgid "Start VabaxOS"
msgstr "Avvia VabaxOS"
