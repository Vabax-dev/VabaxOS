msgid "VabaxOS report"
msgstr "Rapporto di VabaxOS"

msgid "Saved in $file"
msgstr "Salvato in $file"

msgid "It is {time}, {date}."
msgstr "Sono le {time}, {date}."

msgid "No battery: the computer runs on mains power."
msgstr "Nessuna batteria: il computer va a corrente."

msgid "charging"
msgstr "in carica"

msgid "on battery"
msgstr "a batteria"

msgid "full"
msgstr "carica completa"

msgid "plugged in, not charging"
msgstr "collegato, non in carica"

msgid "Battery {level} percent, {state}."
msgstr "Batteria al {level} per cento, {state}."

msgid "Wi-Fi connected to {name}, signal {signal} percent."
msgstr "Wi-Fi collegato a {name}, segnale al {signal} per cento."

msgid "Connected by cable."
msgstr "Collegato con il cavo."

msgid "Wi-Fi not connected."
msgstr "Wi-Fi non collegato."

msgid "No network."
msgstr "Nessuna rete."

msgid "No Bluetooth."
msgstr "Nessun Bluetooth."

msgid "Bluetooth off."
msgstr "Bluetooth spento."

msgid "Bluetooth on, connected to {devices}."
msgstr "Bluetooth acceso, collegato a {devices}."

msgid "Bluetooth on, nothing connected."
msgstr "Bluetooth acceso, nessun dispositivo collegato."

msgid "Volume {level} percent, muted."
msgstr "Volume al {level} per cento, audio disattivato."

msgid "Volume {level} percent."
msgstr "Volume al {level} per cento."

msgid "Computer status"
msgstr "Stato del computer"

# Button names of GNOME Shell (button-names@vabaxos.org, ADR-0022).
msgid "Close"
msgstr "Chiudi"

msgid "Expand"
msgstr "Espandi"

msgid "Collapse"
msgstr "Comprimi"

msgid "Play"
msgstr "Riproduci"

msgid "Pause"
msgstr "Pausa"

msgid "Stop"
msgstr "Ferma"

msgid "Previous"
msgstr "Precedente"

msgid "Next"
msgstr "Successivo"

msgid "Back"
msgstr "Indietro"

msgid "Forward"
msgstr "Avanti"

msgid "More options"
msgstr "Altre opzioni"

msgid "Menu"
msgstr "Menu"

msgid "Clear"
msgstr "Cancella"

msgid "Clear all"
msgstr "Cancella tutto"

msgid "Delete"
msgstr "Elimina"

msgid "Add"
msgstr "Aggiungi"

msgid "Remove"
msgstr "Rimuovi"

msgid "Minimize"
msgstr "Riduci a icona"

msgid "Maximize"
msgstr "Ingrandisci"

msgid "Restore"
msgstr "Ripristina"

msgid "Power Off"
msgstr "Spegni"

msgid "Restart"
msgstr "Riavvia"

msgid "Log Out"
msgstr "Esci"

msgid "Lock"
msgstr "Blocca"

msgid "Settings"
msgstr "Impostazioni"

msgid "Take Screenshot"
msgstr "Cattura schermata"

msgid "Refresh"
msgstr "Aggiorna"

msgid "Search"
msgstr "Cerca"

msgid "Trash"
msgstr "Cestino"

msgid "Show Apps"
msgstr "Mostra applicazioni"

msgid "Firewall on."
msgstr "Firewall attivo."

msgid "Firewall off."
msgstr "Firewall spento."

msgid "Bringing the voice back."
msgstr "Ripristino la voce."

msgid "Voice back."
msgstr "Voce ripristinata."

msgid "The desktop voice does not answer. Console speech works: press Ctrl+Alt+F3."
msgstr "La voce del desktop non risponde. La voce della console funziona: premi Ctrl+Alt+F3."

msgid "Voice settings put back for: {names}."
msgstr "Impostazioni della voce rimesse a posto per: {names}."

msgid "No user on this computer."
msgstr "Nessun utente su questo computer."

msgid "Settings put back for: {names}."
msgstr "Impostazioni rimesse a posto per: {names}."

msgid "No automatic copy found."
msgstr "Nessuna copia automatica trovata."

msgid "Finishing the updates. It may take some minutes."
msgstr "Completo gli aggiornamenti. Può volerci qualche minuto."

msgid "Updates finished."
msgstr "Aggiornamenti completati."

msgid "The updates did not finish: save a report and ask for help."
msgstr "Gli aggiornamenti non sono stati completati: salva un rapporto e chiedi aiuto."

msgid "Report saved: {files}."
msgstr "Rapporto salvato: {files}."

msgid "No report saved."
msgstr "Nessun rapporto salvato."

msgid "Start the desktop"
msgstr "Avvia il desktop"

msgid "Bring the voice back"
msgstr "Rimetti la voce"

msgid "Put back yesterday's settings"
msgstr "Rimetti le impostazioni di ieri"

msgid "Finish interrupted updates"
msgstr "Completa gli aggiornamenti interrotti"

msgid "Save a report"
msgstr "Salva un rapporto"

msgid "Network"
msgstr "Rete"

msgid "Text console"
msgstr "Console di testo"

msgid "Shut down"
msgstr "Spegni"

msgid "VabaxOS recovery mode. Press the number of your choice."
msgstr "Modalità di recupero di VabaxOS. Premi il numero della tua scelta."

msgid "Starting the desktop. Please wait."
msgstr "Avvio il desktop. Attendi."

msgid "Log in with your name and password."
msgstr "Accedi con il tuo nome e la tua password."

msgid "Restarting."
msgstr "Riavvio."

msgid "Shutting down."
msgstr "Spengo."
