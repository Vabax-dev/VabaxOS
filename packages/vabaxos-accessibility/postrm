#!/bin/sh
set -e
if [ "$1" = remove ] || [ "$1" = purge ]; then
    deb-systemd-helper purge vabaxos-voice-off.service >/dev/null || true
fi
if [ "$1" = remove ] || [ "$1" = abort-install ] || [ "$1" = disappear ]; then
    dpkg-divert --package vabaxos-accessibility --rename \
        --remove /etc/xdg/autostart/orca-autostart.desktop
fi
