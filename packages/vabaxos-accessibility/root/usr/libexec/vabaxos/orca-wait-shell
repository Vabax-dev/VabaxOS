#!/bin/sh
# Waits, before Orca starts, until GNOME Shell has turned on its extensions
# (vabaxos-keys@vabaxos.org is the last one it turns on), at most 20
# seconds; at the login screen, or when the user turned that extension
# off, it does not wait.
#
# Why (CI of block 15, 2026-09-26): with the NVDA keys of VabaxOS, Orca
# asks Mutter to hold back many keys when it starts, the keypad too. When
# that came while GNOME Shell was still turning on the extensions, which
# add their own key bindings, GNOME Shell reloaded its bindings and stayed
# frozen for good (main thread waiting on a futex, right after the
# "Overwriting existing binding" lines): no desktop, no speech.
tries=0
while [ "$tries" -lt 40 ]; do
    mode="$(gdbus call --session --dest org.gnome.Shell --object-path /org/gnome/Shell \
        --method org.freedesktop.DBus.Properties.Get org.gnome.Shell Mode 2>/dev/null)"
    case "$mode" in
        *user*) break ;;
        *"'"*) exit 0 ;;  # the login screen, the lock screen: no extensions
    esac
    tries=$((tries + 1))
    sleep 0.5
done
while [ "$tries" -lt 40 ]; do
    gdbus call --session --dest org.gnome.Shell.Extensions --object-path /org/gnome/Shell/Extensions \
        --method org.gnome.Shell.Extensions.GetExtensionInfo vabaxos-keys@vabaxos.org 2>/dev/null \
        | grep -Eq "'state': <[1234]\.0>" && exit 0  # on, off, error or old: done
    tries=$((tries + 1))
    sleep 0.5
done
exit 0
