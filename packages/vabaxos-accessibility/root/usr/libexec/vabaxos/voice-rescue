#!/usr/bin/python3
"""Brings the voice back (block 16): Ctrl+Super+Enter, from anywhere.

triggerhappy reads the keyboard below the desktop (evdev), so the keys work
even when GNOME Shell is frozen or Orca has crashed, and in a text console.
thd runs its commands as nobody: it touches /run/vabaxos-voice-rescue/request
and vabaxos-voice-rescue.path starts this program as root.

Only what takes the voice away is put back (Vabax's choice, 2026-10-03).
For every user with a session, in this order:
 1. sound: the user's PipeWire started again if it does not answer, the
    output unmuted, its volume at least 40 %;
 2. "Bringing the voice back", said at once with eSpeak NG;
 3. speech-dispatcher and its modules stopped (they start again with the
    next phrase);
 4. Orca's settings: a copy is saved first, then speech on, eSpeak NG
    instead of a chosen synthesizer, rate and volume back within safe
    limits, in every profile and program (--orca-settings, as the user);
 5. "Voice back", said through speech-dispatcher, as Orca speaks: it
    proves the whole chain works;
 6. the screen reader turned on and Orca started again.
Then console speech (espeakup) starts again.

    voice-rescue                    everything, as root
    voice-rescue --orca-settings    step 4 only, as the user

VABAXOS_RESCUE_DRY_RUN=FILE writes the commands to FILE instead of running
them (tests/accessibility/test_voice_rescue.py).
"""

import gettext
import json
import os
import pwd
import shutil
import subprocess
import sys
import time

RATE_DEFAULT = 50
RATE_LIMITS = (15, 90)
GAIN_DEFAULT = 10.0
GAIN_MIN = 5.0
VOLUME_MIN = 0.4
VOLUME_SET = 0.5
ESPEAK = ["espeak-ng", "espeak-ng"]
ORCA_START = "/usr/libexec/vabaxos/orca-start"
BACKUPS_KEPT = 5

DRY_RUN = os.environ.get("VABAXOS_RESCUE_DRY_RUN")


def log(message):
    print(f"vabaxos-voice-rescue: {message}", flush=True)


def system_language():
    lang = ""
    try:
        with open(os.environ.get("VABAXOS_LOCALE_FILE", "/etc/default/locale"), encoding="utf-8") as f:
            for line in f:
                if line.startswith("LANG="):
                    lang = line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return "it" if lang.startswith("it") else "en"


LANGUAGE = system_language()
_ = gettext.translation("vabaxos-accessibility", languages=[LANGUAGE], fallback=True).gettext


# -- Orca's settings (as the user) -------------------------------------------------


def fix_voices(voices, changes, where):
    if not isinstance(voices, dict):
        return
    for name, voice in voices.items():
        if not isinstance(voice, dict):
            continue
        rate = voice.get("rate")
        if isinstance(rate, (int, float)) and not RATE_LIMITS[0] <= rate <= RATE_LIMITS[1]:
            voice["rate"] = RATE_DEFAULT
            changes.append(f"{where}: {name} rate {rate} -> {RATE_DEFAULT}")
        gain = voice.get("gain")
        if isinstance(gain, (int, float)) and gain < GAIN_MIN:
            voice["gain"] = GAIN_DEFAULT
            changes.append(f"{where}: {name} volume {gain} -> {GAIN_DEFAULT}")
        # A voice of another synthesizer (Kokoro's im_nicola) means nothing
        # to eSpeak NG.
        if "family" in voice:
            del voice["family"]
            changes.append(f"{where}: {name} voice -> eSpeak NG's")


def fix_settings(settings, changes, where, force_espeak):
    """Puts back, in one group of Orca 48 settings, what silences it:
    speech off, another synthesizer (only where one is set, unless
    force_espeak), a voice too fast, too slow or too quiet."""
    if not isinstance(settings, dict):
        return
    if settings.get("enableSpeech") is False:
        settings["enableSpeech"] = True
        changes.append(f"{where}: speech on")
    info = settings.get("speechServerInfo")
    if info != ESPEAK and (force_espeak or isinstance(info, list)):
        settings["speechServerInfo"] = list(ESPEAK)
        settings["speechServerFactory"] = "orca.speechdispatcherfactory"
        changes.append(f"{where}: synthesizer {info} -> espeak-ng")
    fix_voices(settings.get("voices"), changes, where)


def fix_orca(data):
    """Orca's user-settings.conf (a dict) with its voice put back; returns
    the list of changes. eSpeak NG in the general settings and in every
    profile, which win over them: the system's voice may be Kokoro."""
    changes = []
    fix_settings(data.setdefault("general", {}), changes, "general", force_espeak=True)
    for name, profile in (data.get("profiles") or {}).items():
        fix_settings(profile, changes, f"profile {name}", force_espeak=True)
    return changes


def fix_app(data, app):
    """A program's settings: only the values that silence Orca."""
    changes = []
    for name, profile in (data.get("profiles") or {}).items():
        if isinstance(profile, dict):
            fix_settings(profile.get("general"), changes, f"{app}, profile {name}", force_espeak=False)
    return changes


def write_json(path, data):
    with open(path + ".new", "w", encoding="utf-8") as f:
        json.dump(data, f, indent=4)
    os.replace(path + ".new", path)


def backup(orca_dir, now):
    """A copy of Orca's settings before they change, the last few kept."""
    folder = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"),
                          "vabaxos", "voice-rescue")
    target = os.path.join(folder, now)
    os.makedirs(target, exist_ok=True)
    for name in ("user-settings.conf", "app-settings"):
        source = os.path.join(orca_dir, name)
        if os.path.isdir(source):
            shutil.copytree(source, os.path.join(target, name), dirs_exist_ok=True)
        elif os.path.isfile(source):
            shutil.copy2(source, target)
    for old in sorted(os.listdir(folder))[:-BACKUPS_KEPT]:
        shutil.rmtree(os.path.join(folder, old), ignore_errors=True)
    return target


def orca_settings():
    orca_dir = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "orca")
    path = os.path.join(orca_dir, "user-settings.conf")
    copy = backup(orca_dir, time.strftime("%Y%m%d-%H%M%S"))
    log(f"copy of Orca's settings in {copy}")
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        data = None
    if isinstance(data, dict):
        changes = fix_orca(data)
        if changes:
            write_json(path, data)
        for change in changes:
            log(change)
    apps = os.path.join(orca_dir, "app-settings")
    for name in sorted(os.listdir(apps)) if os.path.isdir(apps) else []:
        if not name.endswith(".conf"):
            continue
        try:
            with open(os.path.join(apps, name), encoding="utf-8") as f:
                app = json.load(f)
        except (OSError, ValueError):
            continue
        if isinstance(app, dict):
            changes = fix_app(app, name[:-5])
            if changes:
                write_json(os.path.join(apps, name), app)
            for change in changes:
                log(change)
    return 0


# -- the system (as root) -----------------------------------------------------------


def run(command, timeout=10, env=None, user=None):
    """Runs a command, as a user when given; True when it worked."""
    if user is not None:
        uid, name = user
        command = ["runuser", "-u", name, "--", "env", f"XDG_RUNTIME_DIR=/run/user/{uid}",
                   f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus",
                   f"HOME={pwd.getpwuid(uid).pw_dir}"] + command
    if DRY_RUN:
        with open(DRY_RUN, "a", encoding="utf-8") as f:
            f.write(" ".join(command) + "\n")
        return True
    try:
        return subprocess.run(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL, timeout=timeout, env=env,
                              check=False).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def output(command, timeout=5, user=None):
    if DRY_RUN:
        run(command, user=user)
        return os.environ.get("VABAXOS_RESCUE_DRY_OUTPUT", "")
    if user is not None:
        uid, name = user
        command = ["runuser", "-u", name, "--", "env", f"XDG_RUNTIME_DIR=/run/user/{uid}",
                   f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus"] + command
    try:
        result = subprocess.run(command, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                                timeout=timeout, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return result.stdout if result.returncode == 0 else None


def users():
    """(uid, name) of every user with a running user manager: the users
    with a session, the login screen's included."""
    found = []
    runtime = os.environ.get("VABAXOS_RESCUE_RUNTIME", "/run/user")
    try:
        entries = sorted(os.listdir(runtime))
    except OSError:
        entries = []
    for entry in entries:
        if not entry.isdigit() or entry == "0":
            continue
        try:
            found.append((int(entry), pwd.getpwuid(int(entry)).pw_name))
        except KeyError:
            continue
    return found


def say_direct(text, uid):
    """Says text with eSpeak NG through the user's PipeWire, or straight on
    the sound card when PipeWire does not answer."""
    env = dict(os.environ, PULSE_SERVER=f"unix:/run/user/{uid}/pulse/native")
    if run(["espeak-ng", "-v", LANGUAGE, text], timeout=15, env=env):
        return True
    return run(["sh", "-c", 'espeak-ng -v "$1" --stdout "$2" | aplay -q -D sysdefault', "say",
                LANGUAGE, text], timeout=15)


def sound(user):
    """The user's PipeWire answering, unmuted, loud enough."""
    volume = output(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], timeout=4, user=user)
    if volume is None:
        log(f"{user[1]}: PipeWire does not answer, starting it again")
        run(["systemctl", "--user", "restart", "pipewire.socket", "pipewire.service",
             "pipewire-pulse.socket", "pipewire-pulse.service", "wireplumber.service"],
            timeout=20, user=user)
        time.sleep(0 if DRY_RUN else 2)
        volume = output(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], timeout=4, user=user) or ""
    run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "0"], user=user)
    try:
        level = float(volume.split()[1])
    except (IndexError, ValueError):
        level = None
    if level is not None and level < VOLUME_MIN:
        log(f"{user[1]}: volume {level:.2f} -> {VOLUME_SET}")
        run(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", str(VOLUME_SET)], user=user)


def stop(uid, pattern, exact):
    """Stops a user's processes by name (never pkill -f: it would find this
    program too): TERM, then KILL for what is left."""
    flag = ["-x"] if exact else []
    run(["pkill", "-TERM", "-u", str(uid)] + flag + [pattern])
    for _ in range(0 if DRY_RUN else 20):
        if not run(["pgrep", "-u", str(uid)] + flag + [pattern], timeout=3):
            return
        time.sleep(0.1)
    run(["pkill", "-KILL", "-u", str(uid)] + flag + [pattern])


def speech_dispatcher(user):
    uid = user[0]
    run(["systemctl", "--user", "stop", "speech-dispatcher.service"], timeout=10, user=user)
    stop(uid, "speech-dispatcher", exact=True)
    # The modules: sd_espeak-ng, sd_kokoro, sd_dummy...
    stop(uid, "^sd_", exact=False)


def orca(user):
    """Orca started again. GNOME starts it again by itself when it stops
    (X-GNOME-AutoRestart in orca-autostart.desktop) or when the screen
    reader is turned on; only when GNOME does not, this program does."""
    uid = user[0]
    was_on = output(["gsettings", "get", "org.gnome.desktop.a11y.applications",
                     "screen-reader-enabled"], user=user)
    stop(uid, "orca", exact=True)
    if (was_on or "").strip() != "true":
        log(f"{user[1]}: screen reader turned on")
        run(["gsettings", "set", "org.gnome.desktop.a11y.applications", "screen-reader-enabled", "true"],
            user=user)
    for _ in range(0 if DRY_RUN else 50):
        time.sleep(0.1)
        if run(["pgrep", "-u", str(uid), "-x", "orca"], timeout=3):
            log(f"{user[1]}: Orca started again by GNOME")
            return
    log(f"{user[1]}: Orca started again")
    run(["systemd-run", "--user", "--collect", "--quiet", ORCA_START, "--replace"], timeout=15, user=user)


def graphical(user):
    """Whether the user has a desktop session (the login screen too)."""
    sessions = output(["loginctl", "list-sessions", "--no-legend"], timeout=5) or ""
    for line in sessions.splitlines():
        words = line.split()
        if len(words) < 3 or words[1] != str(user[0]):
            continue
        kind = output(["loginctl", "show-session", words[0], "-p", "Type", "--value"], timeout=5) or ""
        if kind.strip() in ("wayland", "x11"):
            return True
    return bool(DRY_RUN)


def rescue():
    log("Ctrl+Super+Enter: bringing the voice back")
    found = users()
    spoken = False
    for user in found:
        sound(user)
        if not spoken:
            spoken = say_direct(_("Bringing the voice back."), user[0])
        speech_dispatcher(user)
        if not graphical(user):
            continue
        run([sys.argv[0], "--orca-settings"], timeout=20, user=user)
        if run(["spd-say", "-w", "-l", LANGUAGE, _("Voice back.")], timeout=20, user=user):
            log(f"{user[1]}: speech-dispatcher speaks")
        else:
            log(f"{user[1]}: speech-dispatcher is still silent")
            say_direct(_("The desktop voice does not answer. Console speech works: press Ctrl+Alt+F3."),
                       user[0])
        orca(user)
    if not found:
        say_direct(_("Bringing the voice back."), 0)
    run(["systemctl", "restart", "espeakup.service"], timeout=20)
    log("done")
    return 0


if __name__ == "__main__":
    if "--orca-settings" in sys.argv[1:]:
        sys.exit(orca_settings())
    sys.exit(rescue())
