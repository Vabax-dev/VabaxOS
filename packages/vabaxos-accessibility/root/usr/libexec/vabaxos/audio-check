#!/bin/sh
# Runs in the user session. If the sound card was busy for a moment when
# WirePlumber started (seen on 2026-09-24 in the live system, right after the
# spoken welcome), WirePlumber offers only the "Dummy Output" and never looks
# at the card again: Orca and console speech then go nowhere. Restarting
# WirePlumber finds the card. The root cause is still to be found.

# Nothing to do without a sound card.
grep -q '^ *[0-9]' /proc/asound/cards 2>/dev/null || exit 0

only_dummy() {
    wpctl status 2>/dev/null | sed -n '/Sinks:/,/Sources:/p' | grep -q 'Dummy Output'
}

sleep 3
for _ in 1 2 3; do
    only_dummy || exit 0
    echo "Only the dummy output: restarting WirePlumber"
    systemctl --user restart wireplumber.service
    sleep 3
done
echo "Still only the dummy output: speech may not be heard" >&2
exit 1
