#!/bin/sh
# Starts the first user's manager (UID 1000 and above, with a home folder),
# waits for its PulseAudio socket and starts console speech again on it
# (vabaxos-recovery-audio.service).
uid="$(getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 && $6 ~ "^/home/" {print $3}' | sort -n | head -1)"
[ -n "$uid" ] || exit 0
systemctl start "user@$uid.service" || exit 0
for _ in $(seq 20); do
    [ -S "/run/user/$uid/pulse/native" ] && break
    sleep 0.5
done
systemctl restart espeakup.service || true
