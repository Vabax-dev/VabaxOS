[Unit]
Description=VabaxOS: move console speech into the user's sound session
Documentation=https://github.com/Vabax-dev/VabaxOS/blob/main/packages/README.md

[Service]
Type=oneshot
# espeakup-start picks the user's sound session when it restarts.
ExecStart=/usr/bin/systemctl try-restart espeakup.service
# Stay active, so the path unit does not start this again and again.
RemainAfterExit=yes
