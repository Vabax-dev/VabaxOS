[Unit]
Description=VabaxOS: speech must reach the sound card, not the dummy output
Documentation=https://github.com/Vabax-dev/VabaxOS/blob/main/packages/README.md
After=wireplumber.service pipewire.service
Wants=wireplumber.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/vabaxos/audio-check

[Install]
WantedBy=default.target
