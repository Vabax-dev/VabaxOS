#!/usr/bin/python3
"""Checks a running program the way a screen reader sees it (ADR-0010).

    vabaxos-a11y-check [--wait SECONDS] [--list | --focused] PROGRAM
    vabaxos-a11y-check [--wait SECONDS] --watch-focus SECONDS PROGRAM

Walks the AT-SPI accessibility tree of PROGRAM (the application name, for
example vabaxos-setup, or a part of it, such as nautilus) and reports every control a screen reader user can
reach with the keyboard (shown and focusable buttons, switches, check
boxes, text fields, spin buttons, combo boxes, list items, menu items,
links, sliders) that has neither an accessible name nor text inside it.
With --list it prints every node: depth, role and name. With --focused it
prints only what has the keyboard focus, as Orca would announce it (role and
name), for the tests of the keys. With --watch-focus it listens for SECONDS
to where the focus goes (while a test presses Tab, block 11), prints each
stop and a summary: stops, different controls reached, controls the
keyboard can reach, stops without a name, focus that left the program.

Exit status: 0 if every control has a name, 1 if some have none, 2 if the
program was not found.
"""

import sys
import time

import gi

gi.require_version("Atspi", "2.0")
from gi.repository import Atspi  # noqa: E402

CONTROLS = {
    Atspi.Role.PUSH_BUTTON, Atspi.Role.TOGGLE_BUTTON, Atspi.Role.CHECK_BOX,
    Atspi.Role.RADIO_BUTTON, Atspi.Role.SWITCH if hasattr(Atspi.Role, "SWITCH") else Atspi.Role.TOGGLE_BUTTON,
    Atspi.Role.ENTRY, Atspi.Role.PASSWORD_TEXT, Atspi.Role.SPIN_BUTTON, Atspi.Role.COMBO_BOX,
    Atspi.Role.LIST_ITEM, Atspi.Role.MENU_ITEM, Atspi.Role.LINK, Atspi.Role.SLIDER,
}


def find_application(name):
    """The program with this name; else the first whose name contains it
    (GTK programs may be listed as nautilus or org.gnome.Nautilus)."""
    desktop = Atspi.get_desktop(0)
    apps = [desktop.get_child_at_index(i) for i in range(desktop.get_child_count())]
    apps = [app for app in apps if app is not None]
    for app in apps:
        if app.get_name() == name:
            return app
    for app in apps:
        if name.lower() in (app.get_name() or "").lower():
            return app
    return None


def labelled_by_text(node, depth=5):
    """A control named by the text inside it, such as a button with a
    label: Orca reads that text when the control has no name."""
    if depth == 0:
        return False
    for index in range(node.get_child_count()):
        child = node.get_child_at_index(index)
        if child is None:
            continue
        if (child.get_name() or "").strip() or labelled_by_text(child, depth - 1):
            return True
    return False


def decoration(node):
    """A separator drawn as a menu item (GNOME Shell's popup separators, as
    ArcMenu's line between its columns): exactly two empty panels inside,
    and can_focus off in the code, so the keyboard never stops there. An
    icon-only button shows no children at all and is still reported."""
    if node.get_child_count() != 2:
        return False
    for index in range(2):
        child = node.get_child_at_index(index)
        if child is None or child.get_role() != Atspi.Role.PANEL:
            return False
        if (child.get_name() or "").strip() or child.get_child_count():
            return False
    return True


def describe(node):
    """Role and states of a node, and the names around it, to find it."""
    parent = node.get_parent()
    names = []
    if parent is not None:
        for index in range(parent.get_child_count()):
            sibling = parent.get_child_at_index(index)
            if sibling is not None and sibling is not node:
                name = (sibling.get_name() or "").strip()
                if not name:
                    texts = [sibling.get_child_at_index(i).get_name() for i in range(min(sibling.get_child_count(), 3))
                             if sibling.get_child_at_index(i) is not None]
                    name = " ".join(t for t in texts if t)
                if name:
                    names.append(name)
    states = [s.value_nick for s in node.get_state_set().get_states()]
    parent_role = parent.get_role_name() if parent is not None else "-"
    return f"in {parent_role}, near: {', '.join(names[:4]) or '-'}; states: {', '.join(states)}"


def walk(node, depth, report, listing):
    try:
        role = node.get_role()
        name = (node.get_name() or "").strip()
        states = node.get_state_set()
    except gi.repository.GLib.Error:
        return
    # Only what the keyboard reaches: shown and focusable.
    showing = states.contains(Atspi.StateType.SHOWING) and states.contains(Atspi.StateType.FOCUSABLE)
    if listing:
        print(f"{'  ' * depth}{node.get_role_name()}: {name}")
    if role in CONTROLS and showing and not name and not labelled_by_text(node) and not decoration(node):
        report.append(f"{node.get_role_name()} without a name (depth {depth}), {describe(node)}")
    for index in range(node.get_child_count()):
        child = node.get_child_at_index(index)
        if child is not None:
            walk(child, depth + 1, report, listing)


def text_of(node, depth=3):
    """The name of a node, or the names inside it."""
    name = (node.get_name() or "").strip()
    if name or depth == 0:
        return name
    parts = []
    for index in range(node.get_child_count()):
        child = node.get_child_at_index(index)
        if child is not None:
            parts.append(text_of(child, depth - 1))
    return " ".join(p for p in parts if p)


def focused(node):
    """The deepest shown node that has the keyboard focus, or None: the
    window around the focused control is focused too."""
    try:
        for index in range(node.get_child_count()):
            child = node.get_child_at_index(index)
            found = focused(child) if child is not None else None
            if found is not None:
                return found
        states = node.get_state_set()
        if states.contains(Atspi.StateType.FOCUSED) and states.contains(Atspi.StateType.SHOWING):
            return node
    except gi.repository.GLib.Error:
        pass
    return None


def reachable(node, found, depth=0):
    """Shown, focusable controls a screen reader user can reach."""
    try:
        states = node.get_state_set()
        if (node.get_role() in CONTROLS and states.contains(Atspi.StateType.SHOWING)
                and states.contains(Atspi.StateType.FOCUSABLE) and not decoration(node)):
            found.append(node)
        for index in range(node.get_child_count()):
            child = node.get_child_at_index(index)
            if child is not None and depth < 60:
                reachable(child, found, depth + 1)
    except gi.repository.GLib.Error:
        pass
    return found


def watch_focus(app, seconds):
    """Every focus change for SECONDS: (inside the program, role, name)."""
    from gi.repository import GLib
    stops = []
    app_name = app.get_name()

    def changed(event):
        if not event.detail1:
            return
        node = event.source
        try:
            owner = node.get_application()
            inside = owner is not None and owner.get_name() == app_name
            stops.append((inside, node.get_role_name(), text_of(node), node))
        except GLib.Error:
            stops.append((False, "gone", "", None))

    listener = Atspi.EventListener.new(changed)
    listener.register("object:state-changed:focused")
    GLib.timeout_add(int(seconds * 1000), lambda: (Atspi.event_quit(), False)[1])
    Atspi.event_main()
    listener.deregister("object:state-changed:focused")
    return stops


def main(argv):
    args = argv[1:]
    listing = "--list" in args
    wait = 10.0
    if "--wait" in args:
        wait = float(args[args.index("--wait") + 1])
    names = [a for i, a in enumerate(args)
             if not a.startswith("--") and (i == 0 or args[i - 1] not in ("--wait", "--watch-focus"))]
    if not names:
        print(__doc__)
        return 2
    deadline = time.monotonic() + wait
    app = find_application(names[0])
    while app is None and time.monotonic() < deadline:
        time.sleep(0.5)
        app = find_application(names[0])
    if app is None:
        print(f"{names[0]}: not found on the accessibility bus")
        return 2
    if "--watch-focus" in args:
        seconds = float(args[args.index("--watch-focus") + 1])
        controls = reachable(app, [])
        stops = watch_focus(app, seconds)
        inside = [(role, name, node) for is_in, role, name, node in stops if is_in]
        for is_in, role, name, _node in stops:
            print(f"STOP: {'' if is_in else 'OUTSIDE '}{role}: {name}")
        unnamed = sum(1 for role, name, _n in inside if not name.strip())
        unique = len({(role, name) for role, name, _n in inside})
        print(f"{names[0]}: tab: stops={len(stops)} unique={unique} controls={len(controls)} "
              f"unnamed={unnamed} outside={len(stops) - len(inside)}")
        return 0
    if "--focused" in args:
        node = focused(app)
        if node is None:
            print(f"{names[0]}: focus: none")
            return 1
        print(f"{names[0]}: focus: {node.get_role_name()}: {text_of(node)}")
        return 0
    report = []
    walk(app, 0, report, listing)
    for line in report:
        print("NO NAME: " + line)
    print(f"{names[0]}: {len(report)} controls without a name")
    return 1 if report else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
