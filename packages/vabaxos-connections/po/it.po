msgstr "aperta, cifrata"

msgid "old protection (WEP)"
msgstr "protezione vecchia (WEP)"

msgid "protected with a user name"
msgstr "protetta con nome utente"

msgid "protected"
msgstr "protetta"

msgid "There is no Wi-Fi card."
msgstr "Non c'è una scheda Wi-Fi."

msgid "Wi-Fi is turned off by a switch or by the airplane mode."
msgstr "Il Wi-Fi è spento da un interruttore o dalla modalità aereo."

msgid "Wi-Fi is off."
msgstr "Wi-Fi spento."

msgid "Connected to {network}, {signal}."
msgstr "Collegato a {network}, {signal}."

msgid "Wi-Fi is on, not connected."
msgstr "Wi-Fi acceso, non collegato."
