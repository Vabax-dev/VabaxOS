#!/usr/bin/python3
"""Writes VabaxOS's Orca defaults (NVDA keys, typing echo) as the user's own
values, for every setting the user has not set, before Orca starts
(/usr/libexec/vabaxos/orca-start). See
vabaxos_screen_reader.store.apply_vabaxos_defaults."""

import sys

from vabaxos_screen_reader import store

if __name__ == "__main__":
    count = store.apply_vabaxos_defaults(sys.argv[1] if len(sys.argv) > 1 else store.DEFAULTS_FILE)
    print(f"vabaxos orca defaults: {count} values written")
