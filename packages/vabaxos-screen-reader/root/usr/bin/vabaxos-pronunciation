#!/usr/bin/python3
"""The pronunciation dictionary of the screen reader: words Orca reads
badly, and how to say them.

    vabaxos-pronunciation

The list: each word with how it is said, Listen and Delete on each. At the
bottom: the word, how to say it, Add (Enter in the second field). Changes
reach Orca at once. VabaxOS starts with abbreviations read letter by
letter (txt, PDF, USB...).
"""

import gettext
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, GLib, Gtk  # noqa: E402

from vabaxos_screen_reader import pronunciation, store  # noqa: E402

gettext.textdomain("vabaxos-screen-reader")
_ = gettext.gettext


class PronunciationWindow(Adw.ApplicationWindow):

    def __init__(self, app, settings_store=None, orca=None):
        super().__init__(application=app, title=_("Screen reader pronunciation"))
        self.set_default_size(640, 620)
        self.store = settings_store or store.Store()
        self.orca = orca or store.OrcaService()
        self.settings = self.store.settings(pronunciation.GROUP)
        self.toasts = Adw.ToastOverlay()
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        page = Adw.PreferencesPage()

        new = Adw.PreferencesGroup(title=_("Add a word"),
                                   description=_("One word, then how the screen reader should say it."))
        self.word = Adw.EntryRow(title=_("Word"))
        self.saying = Adw.EntryRow(title=_("How to say it"))
        self.saying.connect("entry-activated", lambda *_a: self.add())
        add = Gtk.Button(label=_("Add"), halign=Gtk.Align.START, margin_top=8)
        add.connect("clicked", lambda *_a: self.add())
        for widget in (self.word, self.saying, add):
            new.add(widget)

        self.group = Adw.PreferencesGroup(title=_("Words"))
        self.rows = []
        page.add(new)
        page.add(self.group)
        view.set_content(page)
        self.toasts.set_child(view)
        self.set_content(self.toasts)
        if self.settings is None:
            self.word.set_sensitive(False)
            self.saying.set_sensitive(False)
            add.set_sensitive(False)
        self.fill()

    def entries(self):
        if self.settings is None:
            return {}
        return dict(self.settings.get_value(pronunciation.KEY).unpack())

    def save(self, entries):
        self.settings.set_value(pronunciation.KEY, GLib.Variant("a{ss}", entries))
        self.settings.sync()
        self.orca.reload()

    def say(self, text):
        self.toasts.add_toast(Adw.Toast.new(text))

    def fill(self):
        for row in self.rows:
            self.group.remove(row)
        self.rows = []
        if self.settings is None:
            row = Adw.ActionRow(title=_("The screen reader (Orca) is not installed."))
            row.set_focusable(True)
            self.group.add(row)
            self.rows.append(row)
            return
        entries = self.entries()
        self.group.set_description(_("{count} words.").format(count=len(entries)))
        for word, saying in sorted(entries.items()):
            row = Adw.ActionRow(title=word, subtitle=_("said: {saying}").format(saying=saying))
            listen = Gtk.Button(label=_("Listen"), valign=Gtk.Align.CENTER)
            listen.update_property([Gtk.AccessibleProperty.LABEL], [_("Listen: {word}").format(word=word)])
            listen.connect("clicked", lambda *_a, s=saying: self.orca.present(s))
            delete = Gtk.Button(label=_("Delete"), valign=Gtk.Align.CENTER)
            delete.update_property([Gtk.AccessibleProperty.LABEL], [_("Delete: {word}").format(word=word)])
            delete.connect("clicked", lambda *_a, w=word: self.delete(w))
            row.add_suffix(listen)
            row.add_suffix(delete)
            self.group.add(row)
            self.rows.append(row)

    def add(self):
        try:
            entries = pronunciation.add(self.entries(), self.word.get_text(), self.saying.get_text())
        except ValueError:
            self.say(_("Write one word, without spaces, and how to say it."))
            return
        word = pronunciation.clean_word(self.word.get_text())
        self.save(entries)
        self.word.set_text("")
        self.saying.set_text("")
        self.fill()
        self.say(_("Added: {word}.").format(word=word))
        self.word.grab_focus()

    def delete(self, word):
        self.save(pronunciation.remove(self.entries(), word))
        self.fill()
        self.say(_("Deleted: {word}.").format(word=word))


class PronunciationApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.vabaxos.Pronunciation")
        self.connect("activate", lambda app: (app.get_active_window() or PronunciationWindow(app)).present())


def main(argv):
    if "--help" in argv or "-h" in argv:
        print(__doc__)
        return 0
    return PronunciationApp().run([argv[0]])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
