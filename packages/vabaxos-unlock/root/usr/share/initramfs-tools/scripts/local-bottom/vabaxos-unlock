#!/bin/sh
# VabaxOS: after the disk is open, say so (ADR-0021). Only when the
# password was asked (the askpass of vabaxos-unlock leaves a mark).
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
    prereqs) prereqs; exit 0 ;;
esac

ROOT="${VABAXOS_UNLOCK_ROOT:-}"
# shellcheck source=/dev/null
. "$ROOT/usr/lib/vabaxos/unlock/speech"
[ -e "$RUN/asked" ] || exit 0
# The prompt may still be speaking: wait for it, at most 10 seconds.
i=0
while pidof aplay >/dev/null 2>&1 && [ "$i" -lt 100 ]; do
    sleep 0.1
    i=$((i + 1))
done
device="$(vabaxos_sound)" && vabaxos_say "$device" "$MSG_OPEN"
exit 0
