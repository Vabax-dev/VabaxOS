msgid "Radio"
msgstr "Radio"

msgid ""
"Write a name or a kind, for example jazz or news. Down arrow goes to the "
"stations, Enter plays."
msgstr ""
"Scrivi un nome o un genere, per esempio jazz o notizie. Freccia giù va alle "
"radio, Invio la fa partire."

msgid "Search a station"
msgstr "Cerca una radio"

msgid "All the world"
msgstr "Tutto il mondo"

msgid "Off: only Italian stations"
msgstr "Spento: solo radio italiane"

msgid "Nothing playing."
msgstr "Niente in ascolto."

msgid "Favourites"
msgstr "Preferite"

msgid "Ctrl+D adds the station playing."
msgstr "Ctrl+D aggiunge la radio in ascolto."

msgid "Stations"
msgstr "Radio"

msgid "Searching…"
msgstr "Cerco…"

msgid "The catalog of the stations does not answer: is Internet connected?"
msgstr "Il catalogo delle radio non risponde: Internet è collegato?"

msgid "The most listened stations."
msgstr "Le radio più ascoltate."

msgid "The most listened Italian stations."
msgstr "Le radio italiane più ascoltate."

msgid "{count} station found."
msgid_plural "{count} stations found."
msgstr[0] "{count} radio trovata."
msgstr[1] "{count} radio trovate."

msgid "No station found for \"{words}\"."
msgstr "Nessuna radio trovata per «{words}»."

msgid "Playing: {station}"
msgstr "In ascolto: {station}"

msgid "{station}."
msgstr "{station}."

msgid "{station} does not answer: try another station."
msgstr "{station} non risponde: prova un'altra radio."

msgid "Choose a station first."
msgstr "Prima scegli una radio."

msgid "Stopped: {station}"
msgstr "Ferma: {station}"

msgid "Stopped."
msgstr "Fermata."

msgid "On air: {title}"
msgstr "In onda: {title}"

msgid "{station} does not say the song on air."
msgstr "{station} non dice il brano in onda."

msgid "Volume {percent} percent."
msgstr "Volume {percent} per cento."

msgid "{station} removed from the favourites."
msgstr "{station} tolta dalle preferite."

msgid "{station} added to the favourites."
msgstr "{station} aggiunta alle preferite."

msgid " and "
msgstr " e "

msgid "{rate} kilobit"
msgstr "{rate} kilobit"
