msgid "I cannot calculate this. Write for example 3+4*2."
msgstr "Non riesco a calcolarlo. Scrivi per esempio 3+4*2."

msgid "{expression} is {result}"
msgstr "{expression} fa {result}"

msgid "Calculator"
msgstr "Calcolatrice"

msgid ""
"Write the calculation, then Enter: 3+4*2, 2,5 × 4, 2^10, radice di 2, 20% di"
" 150."
msgstr ""
"Scrivi il calcolo, poi Invio: 3+4*2, 2,5 × 4, 2^10, radice di 2, 20% di 150."

msgid "Calculation"
msgstr "Calcolo"

msgid "Results"
msgstr "Risultati"

msgid "Copied: {result}"
msgstr "Copiato: {result}"

msgid "No formula: copy one with Ctrl+C, then Super+Alt+M."
msgstr "Nessuna formula: copiane una con Ctrl+C, poi Super+Alt+M."
