#!/usr/bin/python3
"""Translation without Internet.

    vabaxos-translate               the window
    vabaxos-translate --clipboard   translates the text copied with Ctrl+C
                                    (Super+Alt+T)

Write or paste the text, choose the language, Ctrl+Enter translates; the
translation is said and the focus goes on it; Ctrl+Shift+C copies it.
Into Italian by default: an Italian text goes into English. The model is
the one of the descriptions of pictures, downloaded once on request.
"""

import gettext
import subprocess
import sys
import threading

import vabaxos_translate as vt

gettext.textdomain("vabaxos-translate")
_ = gettext.gettext


def present(text):
    try:
        from gi.repository import Gio, GLib
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        bus.call_sync("org.gnome.Orca.Service", "/org/gnome/Orca/Service", "org.gnome.Orca.Service",
                      "PresentMessage", GLib.Variant("(s)", (text,)), None, Gio.DBusCallFlags.NONE, 2000, None)
    except Exception:  # noqa: BLE001 - shown in the window anyway
        pass


def targets():
    return [("it", _("Italian")), ("en", _("English")), ("fr", _("French")), ("de", _("German")),
            ("es", _("Spanish")), ("pt", _("Portuguese"))]


def open_model_window():
    subprocess.Popen(["vabaxos-describe"], start_new_session=True)


def window_classes(speak=present, engine_class=vt.Engine, model_opener=open_model_window):
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, GLib, Gtk

    def run(work, done):
        def thread():
            try:
                result = work()
            except Exception as error:  # noqa: BLE001 - said to the user
                result = error
            GLib.idle_add(lambda: done(result) and False)
        threading.Thread(target=thread, daemon=True).start()

    def text_view(label, editable):
        view = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, editable=editable, accepts_tab=False,
                            top_margin=8, bottom_margin=8, left_margin=8, right_margin=8, cursor_visible=True)
        view.update_property([Gtk.AccessibleProperty.LABEL], [label])
        scroller = Gtk.ScrolledWindow(child=view, min_content_height=150, vexpand=True)
        frame = Gtk.Frame(child=scroller)
        caption = Gtk.Label(label=label, xalign=0, margin_top=8)
        caption.set_mnemonic_widget(view)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.append(caption)
        box.append(frame)
        return view, box

    class TranslateWindow(Adw.ApplicationWindow):

        def __init__(self, app, clipboard=False):
            super().__init__(application=app, title=_("Translator"))
            self.set_default_size(680, 640)
            self.engine = engine_class()
            self.busy = False
            self.toasts = Adw.ToastOverlay()
            view = Adw.ToolbarView()
            view.add_top_bar(Adw.HeaderBar())
            page = Adw.PreferencesPage()
            group = Adw.PreferencesGroup(description=_(
                "Without Internet. Write or paste the text, then Ctrl+Enter. A text already in the chosen "
                "language goes into English."))
            self.source, box = text_view(_("Text to translate"), True)
            group.add(box)
            self.target = Adw.ComboRow(title=_("Into"), model=Gtk.StringList.new([n for _c, n in targets()]))
            group.add(self.target)
            buttons = Gtk.Box(spacing=8, margin_top=8, homogeneous=True)
            self.go = Gtk.Button(label=_("Translate"))
            self.go.set_tooltip_text(_("Translate (Ctrl+Enter)"))
            self.go.add_css_class("suggested-action")
            self.go.connect("clicked", lambda *_a: self.translate())
            copy = Gtk.Button(label=_("Copy the translation"))
            copy.set_tooltip_text(_("Copy the translation (Ctrl+Shift+C)"))
            copy.connect("clicked", lambda *_a: self.copy())
            buttons.append(self.go)
            buttons.append(copy)
            group.add(buttons)
            self.result, box = text_view(_("Translation"), False)
            group.add(box)
            self.model_button = Gtk.Button(label=_("Download the model"), margin_top=8, visible=False)
            self.model_button.set_tooltip_text(_("About 1 GB, once: the same model as the descriptions of pictures"))
            self.model_button.connect("clicked", lambda *_a: model_opener())
            group.add(self.model_button)
            page.add(group)
            view.set_content(page)
            self.toasts.set_child(view)
            self.set_content(self.toasts)
            keys = Gtk.ShortcutController(scope=Gtk.ShortcutScope.MANAGED)
            for accel, action in (("<Control>Return", self.translate), ("<Control><Shift>c", self.copy),
                                  ("Escape", self.close)):
                keys.add_shortcut(Gtk.Shortcut.new(Gtk.ShortcutTrigger.parse_string(accel),
                                                   Gtk.CallbackAction.new(lambda *_a, a=action: a() or True)))
            self.add_controller(keys)
            self.connect("close-request", lambda *_a: self.engine.stop() or False)
            if clipboard:
                self.get_clipboard().read_text_async(None, self.pasted)
            GLib.idle_add(lambda: self.source.grab_focus() and False)

        def say(self, text):
            self.toasts.add_toast(Adw.Toast.new(text))
            speak(text)
            return False

        def pasted(self, clipboard, result):
            try:
                text = clipboard.read_text_finish(result)
            except GLib.Error:
                text = None
            if not text or not text.strip():
                self.say(_("Nothing copied: copy a text with Ctrl+C, then Super+Alt+T."))
                return
            self.source.get_buffer().set_text(text)
            self.translate()

        def translate(self):
            if self.busy:
                return
            buffer = self.source.get_buffer()
            text = buffer.get_text(buffer.get_start_iter(), buffer.get_end_iter(), False)
            if not text.strip():
                self.say(_("Write or paste a text first."))
                return
            if not self.engine.available():
                self.model_button.set_visible(True)
                self.model_button.grab_focus()
                self.say(_("The translation needs the model of the descriptions of pictures: Download the model."))
                return
            self.busy = True
            self.go.set_sensitive(False)
            self.say(_("Translating…"))
            target = targets()[self.target.get_selected()][0]
            fallback = "en" if target != "en" else "it"

            def progress(done, total):
                GLib.idle_add(self.say, _("Part {done} of {total}.").format(done=done, total=total))

            def done(result):
                self.busy = False
                self.go.set_sensitive(True)
                if isinstance(result, Exception):
                    self.say(_("The translation did not work: {error}").format(error=result))
                    return
                self.result.get_buffer().set_text(result)
                self.result.grab_focus()
                self.say(result)
            run(lambda: self.engine.translate(text, target, fallback, progress), done)

        def copy(self):
            buffer = self.result.get_buffer()
            text = buffer.get_text(buffer.get_start_iter(), buffer.get_end_iter(), False)
            if text:
                self.get_clipboard().set(text)
                self.say(_("Translation copied."))

    class TranslateApp(Adw.Application):
        """One window: Super+Alt+T while it is open translates the new copy."""

        def __init__(self):
            from gi.repository import Gio
            super().__init__(application_id="org.vabaxos.Translate",
                             flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
            self.connect("command-line", self.on_command_line)

        def on_command_line(self, app, command_line):
            clipboard = "--clipboard" in command_line.get_arguments()
            window = app.get_active_window()
            if window is None:
                window = TranslateWindow(app, clipboard)
            elif clipboard:
                window.get_clipboard().read_text_async(None, window.pasted)
            window.present()
            return 0

    return TranslateApp, TranslateWindow


def main(argv):
    if "--help" in argv or "-h" in argv:
        print(__doc__)
        return 0
    app_class, _window = window_classes()
    return app_class().run(argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
