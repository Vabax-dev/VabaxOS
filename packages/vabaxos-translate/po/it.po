msgid "Italian"
msgstr "Italiano"

msgid "English"
msgstr "Inglese"

msgid "French"
msgstr "Francese"

msgid "German"
msgstr "Tedesco"

msgid "Spanish"
msgstr "Spagnolo"

msgid "Portuguese"
msgstr "Portoghese"

msgid "Translator"
msgstr "Traduttore"

msgid ""
"Without Internet. Write or paste the text, then Ctrl+Enter. A text already "
"in the chosen language goes into English."
msgstr ""
"Senza Internet. Scrivi o incolla il testo, poi Ctrl+Invio. Un testo già "
"nella lingua scelta va in inglese."

msgid "Text to translate"
msgstr "Testo da tradurre"

msgid "Into"
msgstr "In"

msgid "Translate"
msgstr "Traduci"

msgid "Translate (Ctrl+Enter)"
msgstr "Traduci (Ctrl+Invio)"

msgid "Copy the translation"
msgstr "Copia la traduzione"

msgid "Copy the translation (Ctrl+Shift+C)"
msgstr "Copia la traduzione (Ctrl+Maiusc+C)"

msgid "Translation"
msgstr "Traduzione"

msgid "Download the model"
msgstr "Scarica il modello"

msgid "About 1 GB, once: the same model as the descriptions of pictures"
msgstr ""
"Circa 1 GB, una volta: lo stesso modello della descrizione delle immagini"

msgid "Nothing copied: copy a text with Ctrl+C, then Super+Alt+T."
msgstr "Niente di copiato: copia un testo con Ctrl+C, poi Super+Alt+T."

msgid "Write or paste a text first."
msgstr "Prima scrivi o incolla un testo."

msgid ""
"The translation needs the model of the descriptions of pictures: Download "
"the model."
msgstr ""
"La traduzione chiede il modello della descrizione delle immagini: Scarica il"
" modello."

msgid "Translating…"
msgstr "Traduco…"

msgid "Part {done} of {total}."
msgstr "Parte {done} di {total}."

msgid "The translation did not work: {error}"
msgstr "La traduzione non ha funzionato: {error}"

msgid "Translation copied."
msgstr "Traduzione copiata."
