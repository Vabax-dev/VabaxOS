#!/usr/bin/python3
"""Reading with the camera: the voice guides the paper, then reads it.

    vabaxos-camera

Hold the paper in front of the webcam. About every second VabaxOS says
what to do: more light, nearer, farther, a little to the left or to the
right. When the text is all in the picture and sharp it says "still like
this", takes the picture and opens the text in a window of plain text, as
the screen reader's text recognition does. Ctrl+Enter takes the picture at
once; Ctrl+D describes what the camera sees (with the description model,
downloaded on request); Escape closes.
"""

import gettext
import os
import shutil
import subprocess
import sys
import tempfile
import threading
import time

import vabaxos_camera as vcam

gettext.textdomain("vabaxos-camera")
_ = gettext.gettext

INTERVAL_MS = 1200
REPEAT_SECONDS = 5
READY_FRAMES = 2


def present(text):
    try:
        from gi.repository import Gio, GLib
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        bus.call_sync("org.gnome.Orca1.Service", "/org/gnome/Orca1/Service", "org.gnome.Orca1.Service",
                      "PresentMessage", GLib.Variant("(s)", (text,)), None, Gio.DBusCallFlags.NONE, 2000, None)
    except Exception:  # noqa: BLE001 - shown in the window anyway
        pass


def open_result(program, path):
    """vabaxos-ocr or vabaxos-describe shows the result and deletes the picture."""
    subprocess.Popen([program, "--title", _("Camera"), path], start_new_session=True)


def camera_factory():
    from vabaxos_camera.camera import Camera
    return Camera()


def window_classes(speak=present, camera_factory=camera_factory, guide=vcam.guide, opener=open_result,
                   which=shutil.which):
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, GLib, Gtk

    class CameraWindow(Adw.ApplicationWindow):

        def __init__(self, app):
            super().__init__(application=app, title=_("Read with the camera"))
            self.set_default_size(600, 480)
            self.camera = None
            self.frame = None
            self.busy = False
            self.paused = False
            self.ready_count = 0
            self.last = ("", 0.0)
            self.toasts = Adw.ToastOverlay()
            view = Adw.ToolbarView()
            view.add_top_bar(Adw.HeaderBar())
            page = Adw.PreferencesPage()
            group = Adw.PreferencesGroup(description=_("Hold the paper in front of the camera, still and straight. "
                                                       "The voice tells you how to move it."))
            self.status = Adw.ActionRow(title=_("Starting the camera…"), title_lines=0)
            self.status.set_focusable(True)
            group.add(self.status)
            self.facing = Adw.SwitchRow(title=_("The camera looks at me"),
                                        subtitle=_("On for the webcam above the screen; off for a camera that "
                                                   "looks at the table"), active=True)
            group.add(self.facing)
            self.auto = Adw.SwitchRow(title=_("Take the picture by itself"),
                                      subtitle=_("When the text is all in the picture"), active=True)
            group.add(self.auto)
            buttons = Gtk.Box(spacing=8, margin_top=12, homogeneous=True)
            self.take_button = Gtk.Button(label=_("Take and read"))
            self.take_button.set_tooltip_text(_("Take the picture now and read its text (Ctrl+Enter)"))
            self.take_button.connect("clicked", lambda *_a: self.take("read"))
            self.describe_button = Gtk.Button(label=_("Describe"))
            self.describe_button.set_tooltip_text(_("Describe what the camera sees (Ctrl+D)"))
            self.describe_button.connect("clicked", lambda *_a: self.take("describe"))
            self.again_button = Gtk.Button(label=_("Start again"), visible=False)
            self.again_button.set_tooltip_text(_("Guide another picture"))
            self.again_button.connect("clicked", lambda *_a: self.resume())
            for button in (self.take_button, self.describe_button, self.again_button):
                buttons.append(button)
            group.add(buttons)
            page.add(group)
            view.set_content(page)
            self.toasts.set_child(view)
            self.set_content(self.toasts)
            keys = Gtk.ShortcutController(scope=Gtk.ShortcutScope.MANAGED)
            for accel, action in (("<Control>Return", lambda: self.take("read")),
                                  ("<Control>d", lambda: self.take("describe")), ("Escape", self.close)):
                keys.add_shortcut(Gtk.Shortcut.new(Gtk.ShortcutTrigger.parse_string(accel),
                                                   Gtk.CallbackAction.new(lambda *_a, act=action: act() or True)))
            self.add_controller(keys)
            self.describe_button.set_visible(bool(which("vabaxos-describe")))
            self.connect("close-request", lambda *_a: self.stop() or False)
            GLib.idle_add(self.start)

        def say(self, text, toast=False):
            self.status.set_title(text)
            if toast:
                self.toasts.add_toast(Adw.Toast.new(text))
            speak(text)
            return False

        # -- the camera ----------------------------------------------------

        def start(self):
            try:
                self.camera = camera_factory()
                self.camera.start()
            except Exception:  # noqa: BLE001 - no webcam, or busy
                self.camera = None
                self.say(_("No camera found: connect a webcam, then open this program again."))
                self.take_button.set_sensitive(False)
                self.describe_button.set_sensitive(False)
                self.status.grab_focus()
                return False
            self.say(_("Camera on. Hold the paper in front of it."))
            self.status.grab_focus()
            self.timer = GLib.timeout_add(INTERVAL_MS, self.tick)
            return False

        def stop(self):
            self.paused = True
            if self.camera is not None:
                self.camera.stop()
                self.camera = None

        def tick(self):
            if self.camera is None:
                return False
            if self.busy or self.paused:
                return True
            self.busy = True
            facing = self.facing.get_active()

            def work():
                try:
                    frame = self.camera.frame() if self.camera else None
                    result = (frame, guide(frame, facing) if frame is not None else None)
                except Exception as error:  # noqa: BLE001
                    result = (None, error)
                GLib.idle_add(self.guided, *result)
            threading.Thread(target=work, daemon=True).start()
            return True

        def guided(self, frame, guidance):
            self.busy = False
            if self.paused:
                return False
            if frame is None or isinstance(guidance, Exception) or guidance is None:
                return False
            self.frame = frame
            now = time.monotonic()
            if guidance.sentence != self.last[0] or now - self.last[1] >= REPEAT_SECONDS:
                self.last = (guidance.sentence, now)
                self.say(guidance.sentence)
            self.ready_count = self.ready_count + 1 if guidance.ready else 0
            if self.ready_count >= READY_FRAMES and self.auto.get_active():
                self.take("read")
            return False

        # -- the picture ---------------------------------------------------

        def take(self, what):
            if self.frame is None:
                self.say(_("Wait: the camera has not seen anything yet."), toast=True)
                return
            program = "vabaxos-ocr" if what == "read" else "vabaxos-describe"
            if not which(program):
                self.say(_("The program for this is not installed."), toast=True)
                return
            fd, path = tempfile.mkstemp(prefix="vabaxos-camera-", suffix=".png")
            os.close(fd)
            self.frame.save(path)
            self.paused = True
            self.ready_count = 0
            self.again_button.set_visible(True)
            self.say(_("Picture taken: reading the text.") if what == "read"
                     else _("Picture taken: describing it."))
            opener(program, path)

        def resume(self):
            self.paused = False
            self.again_button.set_visible(False)
            self.last = ("", 0.0)
            self.say(_("Again: hold the next paper in front of the camera."))
            self.status.grab_focus()

    class CameraApp(Adw.Application):
        def __init__(self):
            super().__init__(application_id="org.vabaxos.Camera")
            self.connect("activate", lambda app: (app.get_active_window() or CameraWindow(app)).present())

    return CameraApp, CameraWindow


def main(argv):
    if "--help" in argv or "-h" in argv:
        print(__doc__)
        return 0
    app_class, _window = window_classes()
    return app_class().run([argv[0]])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
