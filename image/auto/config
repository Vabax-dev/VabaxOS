#!/bin/sh
# live-build configuration of the VabaxOS ISO (ADR-0002).
# Run by "lb config" inside the build directory prepared by scripts/build.sh.
# Do not run it directly from image/: live-build writes files next to it.
set -e

# shellcheck source=/dev/null
. ./build.conf

SNAPSHOT_URL="http://snapshot.debian.org/archive"

# Reproducibility: every timestamp in the ISO is the snapshot moment.
# sudo drops environment variables, so the value goes in config/all,
# which every lb command reads before anything else.
SOURCE_DATE_EPOCH="$(date -u -d "$(echo "$VABAXOS_SNAPSHOT" \
    | sed -E 's/^(....)(..)(..)T(..)(..)(..)Z$/\1-\2-\3 \4:\5:\6 UTC/')" +%s)"
export SOURCE_DATE_EPOCH
mkdir -p config
printf 'export SOURCE_DATE_EPOCH=%s\n' "$SOURCE_DATE_EPOCH" > config/all

# Installer (ADR-0007): the Debian Installer in "live" mode copies this live
# system to the disk. As in Debian's own testing live images it is built
# from git at the date of the snapshot (SOURCE_DATE_EPOCH): prebuilt testing
# installer images often do not match the kernel of the archive.
# Firmware (Wi-Fi, sound) is included in the live system and the installer.
#
# Testing ("forky", ADR-0017) has no separate security or updates archive:
# --security false --updates false, as in Debian's own testing live images.
#
# APT indices: the live system points to deb.debian.org, whose indices change
# every day. Keeping them out of the ISO keeps the squashfs reproducible;
# the live system runs "apt update" before installing anything.
#
# Boot parameters of the live system:
# - hostname: the live system is called vabaxos (live-config);
# - console: kernel messages and a login prompt on the first serial port too,
#   so scripts/test-boot.sh can check the boot without a screen.
#   tty0 stays last, so it remains the main console for the screen reader.
# - plymouth.enable=0: no boot splash; the console stays plain text, which
#   Speakup reads and the spoken welcome uses (ADR-0016).
# - systemd.show_status=error: on the console only failures, no "start job
#   is running" lines over the welcome; failures are still read aloud.
lb config noauto \
    --mode debian \
    --distribution "$VABAXOS_DISTRIBUTION" \
    --architecture amd64 \
    --archive-areas "main non-free-firmware" \
    --mirror-bootstrap "$SNAPSHOT_URL/debian/$VABAXOS_SNAPSHOT/" \
    --mirror-chroot "$SNAPSHOT_URL/debian/$VABAXOS_SNAPSHOT/" \
    --mirror-binary "http://deb.debian.org/debian/" \
    --apt-indices false \
    --apt-source-archives false \
    --security false \
    --updates false \
    --bootloaders "grub-efi grub-pc" \
    --uefi-secure-boot enable \
    --binary-images iso-hybrid \
    --debian-installer live \
    --debian-installer-distribution git \
    --debian-installer-gui true \
    --firmware-chroot true \
    --firmware-binary true \
    --memtest none \
    --iso-application "VabaxOS" \
    --iso-publisher "VabaxOS; https://github.com/Vabax-dev/VabaxOS" \
    --iso-volume "VabaxOS" \
    --bootappend-live "boot=live components quiet hostname=vabaxos console=ttyS0,115200n8 console=tty0 plymouth.enable=0 systemd.show_status=error" \
    "$@"
