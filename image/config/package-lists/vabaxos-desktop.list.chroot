# GNOME desktop on Wayland (ADR-0004). gnome-core already brings Orca,
# GDM, PipeWire and the basic applications; NetworkManager, Firefox ESR
# and all locales come as recommended packages.
gnome-core
# The Start menu is vabaxos-start (ADR-0025): ArcMenu is no longer installed.
# A familiar interface (block 8): taskbar at the bottom with the open and
# pinned programs, tray icons, desktop icons, clipboard history (Ctrl+Alt+H),
# windows side by side and in quarters like Snap in Windows 11.
gnome-shell-extension-dash-to-panel
gnome-shell-extension-appindicator
gnome-shell-extension-desktop-icons-ng
gnome-shell-extension-gpaste
gnome-shell-extension-tiling-assistant
gnome-system-monitor
# One look for the whole system: Atkinson Hyperlegible Next, a font made
# for low vision (vabaxos-branding); log in and log out sounds.
fonts-atkinson-hyperlegible-next
gnome-session-canberra
network-manager
# Applications from outside Debian (ADR-0008), updated by vabaxos-update.
flatpak
locales-all

# Encrypted disk (ADR-0021): the installer copies this system, so the tools
# for "guided - use entire disk and set up encrypted LVM" must be in it;
# vabaxos-unlock speaks when the passphrase is asked at boot.
cryptsetup
cryptsetup-initramfs
lvm2

# Language and keyboard, chosen in the boot menu or in the welcome.
keyboard-configuration
console-setup

# Speech (ADR-0005, ADR-0006). The VabaxOS packages (vabaxos-accessibility, vabaxos-apps,
# vabaxos-branding, vabaxos-reader, vabaxos-screen-reader, vabaxos-settings, vabaxos-setup, vabaxos-sounds, vabaxos-start,
# vabaxos-update, vabaxos-welcome, vabaxos-ocr, vabaxos-unlock, vabaxos-tuning,
# vabaxos-firewall, vabaxos-dictation, vabaxos-restore, vabaxos-lessons,
# vabaxos-reminders, vabaxos-print, vabaxos-math, vabaxos-describe,
# vabaxos-news, vabaxos-communication)
# are built from packages/ by
# scripts/build-packages.sh and installed by live-build automatically.
# vabaxos-voice (Kokoro) stays out of the ISO for now: only eSpeak NG (ADR-0026).
espeakup
espeak-ng
speech-dispatcher-espeak-ng

# Virtual machines: VMware (Vabax tries VabaxOS in VMware Workstation):
# screen size that follows the window, shared clipboard, clean shutdown.
# Its services start only inside VMware.
open-vm-tools-desktop
