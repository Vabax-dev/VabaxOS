#!/bin/sh
# Debian packages rebuilt with VabaxOS's small fixes (ADR-0026).
#
# scripts/build.sh copies patches/debian/ and scripts/build-debian-patched.sh
# to /usr/src/vabaxos-debian-patched. The script downloads Debian's source
# of the installed version, from the same snapshot as the binary packages,
# adds the fixes, builds it with the version <Debian's>+0vabaxos1 and
# installs the rebuilt packages over Debian's. "+0vabaxos1" sorts after
# Debian's version and before any update of it ("+deb13u1" of
# trixie-security, "+b1"): a security update of Debian always wins
# (ADR-0028), and the VabaxOS archive rebuilds it with the fixes every day
# with the same script. What the builds installed is removed at the end.
set -e

top=/usr/src/vabaxos-debian-patched
[ -d "$top" ] || exit 0
sh "$top/build-debian-patched.sh" --installed --install "$top"
rm -rf "$top"
