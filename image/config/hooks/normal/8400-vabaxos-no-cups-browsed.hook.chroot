#!/bin/sh
# VabaxOS: no cups-browsed (it may come as a recommended package of CUPS).
# Its old browsing on UDP 631 was the door of CVE-2024-47176; CUPS finds
# network printers through mDNS by itself. vabaxos-print pins it out for
# later installations.
set -e
if dpkg-query -W -f '${Status}' cups-browsed 2>/dev/null | grep -q 'install ok installed'; then
    apt-get purge -y cups-browsed
fi
